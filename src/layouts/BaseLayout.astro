---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: string;
}

const {
  title = "Clean & Fast Web Starter",
  description,
  image,
  canonicalURL,
  type,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
