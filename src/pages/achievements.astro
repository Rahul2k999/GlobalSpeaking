---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/Stats.astro';
import Achievements from '../components/Achievements.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name } = siteData;
---

<BaseLayout
  title={`Achievements & Corporate Placements – ${name}`}
  description="Over 15,000 students trained, 1,700+ multinational corporate placements, and 1,000+ educators placed in CBSE and English-medium schools."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Track Record of Success</span>
      <h1 class="page-title">Achievements &amp; Placements</h1>
      <p class="page-subtitle">
        Explore how our learner-focused training and communication coaching have empowered 15,000+ students, graduates, and working professionals in Amravati.
      </p>
    </div>
  </section>

  <!-- Key Statistics Counter -->
  <Stats />

  <!-- Achievements Component Grid with Milestones, Awards & Corporate Candidates Section -->
  <Achievements />

  <!-- Admissions / Contact -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>
