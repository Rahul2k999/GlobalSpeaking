---
import BaseLayout from '../../layouts/BaseLayout.astro';
import coursesData from '../../data/courses.json';
import Contact from '../../components/Contact.astro';
import siteData from '../../data/site.json';

export function getStaticPaths() {
  return coursesData.map((course) => ({
    params: { slug: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
const { name, contact } = siteData;
---

<BaseLayout
  title={`${course.title} Course – ${name}`}
  description={course.shortDescription}
>
  <!-- Course Hero -->
  <section class="course-hero">
    <div class="container course-hero__inner">
      <div class="course-hero__breadcrumbs">
        <a href="/">Home</a> &rarr; <a href="/courses">Courses</a> &rarr; <span>{course.title}</span>
      </div>

      <div class="course-hero__badge">{course.badge}</div>
      <h1 class="course-hero__title">{course.title}</h1>
      <p class="course-hero__tagline">{course.tagline}</p>
      <p class="course-hero__desc">{course.shortDescription}</p>

      <div class="course-hero__meta">
        <div class="meta-item">
          <span class="meta-label">Duration</span>
          <span class="meta-val">{course.duration}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-label">Levels &amp; Focus</span>
          <span class="meta-val">{course.level}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-label">Training Mode</span>
          <span class="meta-val">{course.mode}</span>
        </div>
      </div>

      <div class="course-hero__actions">
        <a href="#enquiry-section" class="btn btn-yellow btn-lg">
          Enquire for Admission
        </a>
        <a href="#focus-areas" class="btn btn-outline-white btn-lg">
          Key Focus Areas &darr;
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Overview & Focus Areas -->
  <section class="section" id="focus-areas">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-left">
          <h2 class="overview-title">Course Overview</h2>
          <p class="overview-desc">{course.fullDescription}</p>

          <div class="feature-banner">
            <h4 class="feature-banner__title">Special Feature</h4>
            <p class="feature-banner__desc">{course.specialFeature}</p>
          </div>

          <!-- Key Focus Areas Breakdown -->
          <div class="syllabus-section">
            <h2 class="syllabus-heading">Key Focus Areas</h2>
            <div class="syllabus-phases">
              {course.keyFocusAreas.map((area, idx) => (
                <div class="phase-card">
                  <div class="phase-header">
                    <span class="phase-number">0{idx + 1}</span>
                    <h3 class="phase-title">{area}</h3>
                  </div>
                  <p class="phase-desc">
                    Comprehensive, activity-based training designed for direct speaking application and noticeable daily improvement.
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar / Features & Fast CTA -->
        <aside class="overview-sidebar">
          <div class="sidebar-card">
            {course.image && (
              <div class="sidebar-course-media">
                <img
                  src={course.image}
                  alt={`${course.title} Classroom Session`}
                  width="400"
                  height="225"
                  loading="lazy"
                  class="sidebar-course-img"
                />
              </div>
            )}
            <h3 class="sidebar-title">What is Included:</h3>
            <ul class="sidebar-features">
              {course.keyFeatures.map((f) => (
                <li class="sidebar-item">
                  <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <div class="sidebar-cta-wrap">
              <a href="#enquiry-section" class="btn btn-yellow sidebar-btn">
                Enquire for Admission
              </a>
              <a 
                href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(`Hello Global Spoken English, I want to inquire about the ${course.title} course.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp sidebar-btn"
              >
                WhatsApp Enquiry
              </a>
              <a href="/courses" class="btn btn-outline-blue sidebar-btn">
                View All Courses
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Contact & Enquiry Form -->
  <Contact />
</BaseLayout>

<style>
  .course-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-12) 0 var(--space-16);
  }

  .course-hero__inner {
    max-width: 860px;
  }

  .course-hero__breadcrumbs {
    font-size: var(--text-xs);
    color: #94A3B8;
    margin-bottom: var(--space-4);
  }

  .course-hero__breadcrumbs a {
    color: #CBD5E1;
  }

  .course-hero__breadcrumbs a:hover {
    color: var(--color-accent-yellow);
  }

  .course-hero__badge {
    display: inline-block;
    background-color: rgba(255, 201, 40, 0.2);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.4);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .course-hero__title {
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: var(--space-2);
  }

  .course-hero__tagline {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent-yellow);
    margin-bottom: var(--space-4);
  }

  .course-hero__desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .course-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    background-color: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-8);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-size: 0.7rem;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .meta-val {
    font-size: var(--text-sm);
    font-weight: 800;
    color: #FFFFFF;
    margin-top: 2px;
  }

  .meta-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.15);
    display: none;
  }

  @media (min-width: 640px) {
    .meta-divider {
      display: block;
    }
  }

  .course-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 540px) {
    .course-hero__actions {
      flex-direction: column;
    }
    .course-hero__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .btn-outline-white {
    background-color: transparent;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .btn-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }

  /* Overview & Sidebar Grid */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .overview-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .overview-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-4);
  }

  .overview-desc {
    font-size: var(--text-base);
    color: var(--color-text-main);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .feature-banner {
    background-color: var(--color-bg-light-blue);
    border-left: 4px solid var(--color-secondary-blue);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-8);
  }

  .feature-banner__title {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-secondary-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .feature-banner__desc {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-navy);
    margin: 0;
  }

  /* Syllabus Phases */
  .syllabus-section {
    margin-top: var(--space-8);
  }

  .syllabus-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-6);
  }

  .syllabus-phases {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .phase-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-4);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  @media (min-width: 640px) {
    .phase-card {
      padding: var(--space-6);
    }
  }

  .phase-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .phase-number {
    background-color: var(--color-primary-navy);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--text-xs);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .phase-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin: 0;
  }

  .phase-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
    padding-left: 2.2rem;
  }

  /* Sidebar */
  .overview-sidebar {
    position: sticky;
    top: 90px;
  }

  .sidebar-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-4);
    box-shadow: 0 10px 30px rgba(11, 47, 99, 0.08);
  }

  @media (min-width: 640px) {
    .sidebar-card {
      padding: var(--space-8);
    }
  }

  .sidebar-course-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-6);
    background-color: var(--color-bg-light-blue);
  }

  .sidebar-course-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sidebar-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: var(--space-8);
  }

  .sidebar-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: var(--leading-normal);
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: #20B45B;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .sidebar-cta-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-btn {
    width: 100%;
    text-align: center;
    padding: 0.75rem var(--space-4);
    font-size: var(--text-sm);
  }
</style>
