---
import BaseLayout from '../../layouts/BaseLayout.astro';
import coursesData from '../../data/courses.json';
import Contact from '../../components/Contact.astro';

export function getStaticPaths() {
  return coursesData.map((course) => ({
    params: { slug: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
---

<BaseLayout
  title={`${course.title} Course Syllabus & Details`}
  description={course.shortDescription}
>
  <!-- Course Hero -->
  <section class="course-hero">
    <div class="container course-hero__inner">
      <div class="course-hero__breadcrumbs">
        <a href="/">Home</a> &rarr; <a href="/courses">Courses</a> &rarr; <span>{course.title}</span>
      </div>

      <div class="course-hero__badge">{course.badge}</div>
      <h1 class="course-hero__title">{course.title}</h1>
      <p class="course-hero__tagline">{course.tagline}</p>
      <p class="course-hero__desc">{course.shortDescription}</p>

      <div class="course-hero__meta">
        <div class="meta-item">
          <span class="meta-label">Duration</span>
          <span class="meta-val">{course.duration}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-label">Level</span>
          <span class="meta-val">{course.level}</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <span class="meta-label">Mode</span>
          <span class="meta-val">{course.mode}</span>
        </div>
      </div>

      <div class="course-hero__actions">
        <a href="#enquiry-section" class="btn btn-yellow btn-lg">
          Book Free Demo Class
        </a>
        <a href="#syllabus" class="btn btn-outline-white btn-lg">
          Explore Syllabus &darr;
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Overview & Features -->
  <section class="section">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-left">
          <h2 class="overview-title">Course Overview</h2>
          <p class="overview-desc">{course.fullDescription}</p>

          <div class="timings-banner">
            <h4 class="timings-banner__title">Batch Timings &amp; Schedules</h4>
            <p class="timings-banner__desc">{course.batchTimings}</p>
          </div>

          <!-- Phase-by-Phase Syllabus -->
          <div class="syllabus-section" id="syllabus">
            <h2 class="syllabus-heading">Curriculum &amp; Module Breakdown</h2>
            <div class="syllabus-phases">
              {course.syllabus.map((phase, idx) => (
                <div class="phase-card">
                  <div class="phase-header">
                    <span class="phase-number">0{idx + 1}</span>
                    <h3 class="phase-title">{phase.phase}</h3>
                  </div>
                  <ul class="phase-topics">
                    {phase.topics.map((t) => (
                      <li class="topic-item">
                        <svg class="topic-dot" viewBox="0 0 20 20" fill="currentColor">
                          <circle cx="10" cy="10" r="4"/>
                        </svg>
                        <span>{t}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar / Features & Fast CTA -->
        <aside class="overview-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">What is Included:</h3>
            <ul class="sidebar-features">
              {course.keyFeatures.map((f) => (
                <li class="sidebar-item">
                  <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <div class="sidebar-cta-wrap">
              <a href="#enquiry-section" class="btn btn-yellow sidebar-btn">
                Enroll In This Batch
              </a>
              <a href="/courses" class="btn btn-outline-blue sidebar-btn">
                Compare All 3 Programs
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Contact & Enquiry Form -->
  <Contact />
</BaseLayout>

<style>
  .course-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-12) 0 var(--space-16);
  }

  .course-hero__inner {
    max-width: 860px;
  }

  .course-hero__breadcrumbs {
    font-size: var(--text-xs);
    color: #94A3B8;
    margin-bottom: var(--space-4);
  }

  .course-hero__breadcrumbs a {
    color: #CBD5E1;
  }

  .course-hero__breadcrumbs a:hover {
    color: var(--color-accent-yellow);
  }

  .course-hero__badge {
    display: inline-block;
    background-color: rgba(255, 201, 40, 0.2);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.4);
    font-size: var(--text-xs);
    font-weight: 800;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .course-hero__title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .course-hero__tagline {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 700;
    color: var(--color-accent-yellow);
    margin-bottom: var(--space-4);
  }

  .course-hero__desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .course-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-8);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    font-weight: 700;
    color: #94A3B8;
  }

  .meta-val {
    font-size: var(--text-sm);
    font-weight: 800;
    color: #FFFFFF;
  }

  .meta-divider {
    width: 1px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .course-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Main Grid */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .overview-grid {
      grid-template-columns: 1.35fr 0.65fr;
    }
  }

  .overview-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-3);
  }

  .overview-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .timings-banner {
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .timings-banner__title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.25rem;
  }

  .timings-banner__desc {
    font-size: var(--text-xs);
    color: var(--color-text-main);
    margin: 0;
  }

  /* Syllabus Phases */
  .syllabus-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-6);
  }

  .syllabus-phases {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .phase-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  .phase-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .phase-number {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 900;
    color: var(--color-secondary-blue);
    background-color: var(--color-bg-light-blue);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .phase-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
  }

  .phase-topics {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .topic-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .topic-dot {
    width: 12px;
    height: 12px;
    color: var(--color-secondary-blue);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Sidebar */
  .sidebar-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.06);
    position: sticky;
    top: 6rem;
  }

  .sidebar-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-4);
  }

  .sidebar-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: var(--space-6);
  }

  .sidebar-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: var(--color-whatsapp-green);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .sidebar-cta-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-btn {
    width: 100%;
    text-align: center;
  }
</style>