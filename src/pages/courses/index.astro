---
import BaseLayout from '../../layouts/BaseLayout.astro';
import coursesData from '../../data/courses.json';
import Contact from '../../components/Contact.astro';

const levels = [
  { level: "Levels 1–2", title: "Foundation & Hesitation Eradication", desc: "Thought-translation elimination, fear release, daily essential active phrase bank." },
  { level: "Levels 3–4", title: "Functional Grammar & Daily Dialogue", desc: "Tenses in speech, active vocabulary, questions, polite negotiations, and telephonic etiquette." },
  { level: "Levels 5–6", title: "Spontaneous Fluency & Impromptu Speech", desc: "Extempore speaking, Just A Minute (JAM), storytelling, accent softening, and speech rhythm." },
  { level: "Levels 7–8", title: "Podium Presence & Voice Modulation", desc: "Stage fear overcome, mic drills, body language, commanding posture, and dynamic vocal pitch." },
  { level: "Levels 9–10", title: "Executive Debates & Group Discussions", desc: "Rebuttal skills, boardroom vocabulary, conflict de-escalation, and non-verbal charisma." },
  { level: "Levels 11–12", title: "Corporate Interview Mastery & Global Lead", desc: "STAR behavioral technique, panel mock interviews, salary negotiation, and executive poise." }
];
---

<BaseLayout
  title="Our Courses & 12-Level English Fluency System"
  description="Explore our Spoken English, Personality Development, and Interview Preparation courses scientifically sequenced across 12 levels."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Structured Academic Pathways</span>
      <h1 class="page-title">Comprehensive English &amp; Grooming Programs</h1>
      <p class="page-subtitle">
        Whether you struggle with basic conversation or want to command multinational boardrooms, our modular 12-level method delivers permanent fluency.
      </p>
    </div>
  </section>

  <!-- Courses Detail Cards Section -->
  <section class="section">
    <div class="container">
      <div class="courses-detailed-list">
        {coursesData.map((course) => (
          <article class="course-detailed-card" id={course.slug}>
            <div class="card-meta-bar">
              <span class="course-badge">{course.badge}</span>
              <span class="course-duration-pill">⏱️ {course.duration}</span>
              <span class="course-level-pill">📊 {course.level}</span>
            </div>

            <div class="card-main-grid">
              <div class="card-left">
                <h2 class="course-title">
                  <a href={`/courses/${course.slug}`}>{course.title}</a>
                </h2>
                <p class="course-tagline">{course.tagline}</p>
                <p class="course-full-desc">{course.fullDescription}</p>

                <div class="timings-box">
                  <strong>Batch Timings:</strong> {course.batchTimings}
                </div>

                <div class="card-actions">
                  <a href={`/courses/${course.slug}`} class="btn btn-call">
                    View Full Syllabus &amp; Phases &rarr;
                  </a>
                  <a href="#enquiry-section" class="btn btn-yellow">
                    Book Free Demo Class
                  </a>
                </div>
              </div>

              <div class="card-right">
                <h4 class="features-title">What You Will Master:</h4>
                <ul class="features-checklist">
                  {course.keyFeatures.map((feat) => (
                    <li>
                      <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 12-Level System Matrix -->
  <section class="section section--light-blue">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Scientific Progression</span>
        <h2 class="section-title">The Signature <span class="highlight-yellow">12-Level</span> Learning Ladder</h2>
        <p class="section-subtitle">
          Every student undergoes a personal entrance diagnostic and starts precisely at their comfort level, graduating level-by-level through verified speaking assessments.
        </p>
      </div>

      <div class="levels-grid">
        {levels.map((lvl) => (
          <div class="level-card">
            <span class="level-badge">{lvl.level}</span>
            <h3 class="level-title">{lvl.title}</h3>
            <p class="level-desc">{lvl.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Enquiry Section -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }

  .courses-detailed-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .course-detailed-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 10px 30px rgba(11, 47, 99, 0.06);
    transition: box-shadow var(--transition-base);
  }

  .course-detailed-card:hover {
    box-shadow: 0 16px 40px rgba(11, 47, 99, 0.1);
  }

  .card-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .course-badge {
    background-color: var(--color-bg-light-blue);
    color: var(--color-secondary-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .course-duration-pill,
  .course-level-pill {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-light-grey);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .card-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .card-main-grid {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }

  .course-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .course-title a {
    color: var(--color-primary-navy);
  }

  .course-tagline {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-secondary-blue);
    margin-bottom: var(--space-4);
  }

  .course-full-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .timings-box {
    background-color: var(--color-bg-light-grey);
    border: 1px solid var(--color-border);
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text-main);
    margin-bottom: var(--space-6);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .card-right {
    background-color: var(--color-bg-light-blue);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    border: 1px solid rgba(7, 87, 166, 0.12);
  }

  .features-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .features-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .features-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: 1.4;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: var(--color-whatsapp-green);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Levels Grid */
  .levels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .levels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .levels-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .level-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  .level-badge {
    display: inline-block;
    background-color: var(--color-primary-navy);
    color: var(--color-accent-yellow);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .level-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
  }

  .level-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
</style>