---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Courses from '../components/Courses.astro';
import Trainer from '../components/Trainer.astro';
import Achievements from '../components/Achievements.astro';
import Gallery from '../components/Gallery.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const pageTitle = `${siteData.name} – ${siteData.slogan}`;
const pageDesc = `${siteData.subSlogan}. 15,000+ Students Trained, 1,700+ MNC Selections, 1,000+ Teachers Placed. Join Coach Faizan Khan's 12-Level Spoken English & Personality Development Program.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- 1. Hero Banner -->
  <Hero />

  <!-- 2. Achievement Statistics -->
  <Stats />

  <!-- 3. Our Courses -->
  <Courses showAllLink={true} />

  <!-- 4. Meet Our Trainer & Why Choose Us -->
  <Trainer />

  <!-- 5. Our Achievements -->
  <Achievements />

  <!-- 6. Gallery -->
  <Gallery limit={6} showFilters={true} />

  <!-- 7. Video Testimonials -->
  <VideoTestimonials />

  <!-- 8. Student Reviews -->
  <Reviews limit={6} />

  <!-- 9. Contact & Enquiry -->
  <Contact />
</BaseLayout>
