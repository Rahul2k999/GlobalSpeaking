---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name } = siteData;
---

<BaseLayout
  title={`Contact & Branch Locations – ${name}`}
  description="Contact Global Spoken English in Amravati, Maharashtra. Visit our branches at Gadge Nagar and Jamil Colony, or connect via WhatsApp and Phone."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Admissions &amp; Enquiries</span>
      <h1 class="page-title">Contact &amp; Locations</h1>
      <p class="page-subtitle">
        Schedule your individual level assessment, visit our branches in Amravati, or enquire directly via WhatsApp and Phone.
      </p>
    </div>
  </section>

  <!-- Contact Component & Enquiry Form (includes both branches and Google Maps links) -->
  <Contact />

  <!-- FAQ Section for Prospective Students -->
  <section class="section section--light-blue">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Frequently Asked Questions</span>
        <h2 class="section-title">Common <span class="highlight-yellow">Admissions</span> Questions</h2>
        <p class="section-subtitle">Everything you need to know before joining your course at Global Spoken English.</p>
      </div>

      <div class="faq-grid">
        <div class="faq-card">
          <h3 class="faq-question">How do you assess a student's starting level?</h3>
          <p class="faq-answer">
            With a strong focus on individual requirements, we assess each candidate's current communication level before recommending the most suitable course and learning path across our 12 learning levels.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">Where are your branches located in Amravati?</h3>
          <p class="faq-answer">
            We operate two branches: Branch 1 is at Gadge Nagar (Infront of Polytechnic College, Beside Shan Honda Showroom) and Branch 2 is at Jamil Colony (Infront of Samar Medical).
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">What courses are currently offered?</h3>
          <p class="faq-answer">
            We offer three specialized programs: Spoken English (40 Days – 3 Months with 12 separate learning levels), Personality Development (4 Weeks), and Interview Preparation (10 Days).
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">Who leads the coaching and mentoring?</h3>
          <p class="faq-answer">
            Training is directed by Coach Faizan Khan, Communication Skills &amp; PD Coach, Corporate Trainer, NLP Practitioner, and recipient of the prestigious Bharat Bhushan Award 2025 at Rashtrapati Bhavan.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .faq-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  .faq-question {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-2);
  }

  .faq-answer {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
