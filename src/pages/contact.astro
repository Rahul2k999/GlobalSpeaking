---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="Contact Us & Admissions Support"
  description="Get in touch with GLOBAL Institute admissions team. Call, WhatsApp, or visit our central campus for personal fluency assessment."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Admissions Open</span>
      <h1 class="page-title">Contact GLOBAL Institute</h1>
      <p class="page-subtitle">
        Schedule your free fluency assessment, meet our master trainers, or ask any question regarding batch timings and fees.
      </p>
    </div>
  </section>

  <!-- Contact Component & Enquiry Form -->
  <Contact />

  <!-- FAQ Section for Prospective Students -->
  <section class="section section--light-blue">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Frequently Asked Questions</span>
        <h2 class="section-title">Common <span class="highlight-yellow">Enquiry</span> Questions</h2>
        <p class="section-subtitle">Everything you need to know before joining your first demo class.</p>
      </div>

      <div class="faq-grid">
        <div class="faq-card">
          <h3 class="faq-question">Do you offer a free demo class?</h3>
          <p class="faq-answer">
            Yes! Every candidate is invited to attend a 1-on-1 fluency evaluation and a complimentary classroom demo session before enrolling.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">What is the average batch size?</h3>
          <p class="faq-answer">
            To ensure personal microphone time and interactive podium participation, all speaking batches are strictly capped at 12–15 students.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">Are evening and weekend slots available?</h3>
          <p class="faq-answer">
            Yes. We offer morning slots for college students (8 AM – 11 AM), evening slots for working executives (5 PM – 8 PM), and dedicated weekend fast-track batches.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-question">Will I get placement and interview assistance?</h3>
          <p class="faq-answer">
            Absolutely. Students enrolled in our 12-Level Advanced Mastery program receive dedicated STAR interview drills, resume polishing, and direct referrals to hiring MNC partners.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .faq-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  .faq-question {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-2);
  }

  .faq-answer {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>