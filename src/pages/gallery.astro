---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name } = siteData;
---

<BaseLayout
  title={`Photo Gallery & Institute Life – ${name}`}
  description="Explore life at Global Spoken English & Personality Development Institute in Amravati, Maharashtra."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Institute Photo Gallery</span>
      <h1 class="page-title">Life at {name}</h1>
      <p class="page-subtitle">
        Step into our interactive classrooms, group discussions, workshops, and student community celebrations in Amravati.
      </p>
    </div>
  </section>

  <!-- Full Gallery Component with All Photos -->
  <Gallery limit={6} showFilters={false} />

  <!-- Admissions CTA -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>