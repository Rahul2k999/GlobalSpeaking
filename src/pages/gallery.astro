---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="Campus Life & Activity Photo Gallery"
  description="Immerse yourself in life at GLOBAL Institute. Podiums, GD arenas, interactive classroom drills, and convocation award ceremonies."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Institute Photo Gallery</span>
      <h1 class="page-title">Life at GLOBAL Institute</h1>
      <p class="page-subtitle">
        Step into our high-energy speech arenas, podium practice stages, and vibrant student community celebrations.
      </p>
    </div>
  </section>

  <!-- Full Gallery Component with All Photos -->
  <Gallery limit={12} showFilters={true} />

  <!-- Admissions CTA -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>