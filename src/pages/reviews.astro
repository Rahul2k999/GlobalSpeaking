---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name } = siteData;
---

<BaseLayout
  title={`Google Reviews & Student Feedback – ${name}`}
  description="Read verified student feedback and reviews for Global Spoken English, Amravati directly on our official Google Business page."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Verified Feedback</span>
      <h1 class="page-title">Google Reviews &amp; Feedback</h1>
      <p class="page-subtitle">
        Authentic reviews and testimonials from our students, graduates, and working professionals on Google Business.
      </p>
    </div>
  </section>

  <!-- Complete Reviews Component -->
  <Reviews />

  <!-- Contact / Booking -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>
