---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';

const { name, contact } = siteData;
---

<BaseLayout
  title={`Privacy Policy – ${name}`}
  description={`${name}'s commitment to student data privacy, transparency, and information security.`}
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="page-subtitle">Last Updated: November 2026</p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section">
    <div class="container privacy-content">
      <h2>1. Introduction</h2>
      <p>
        At {name}, we value and respect your privacy. This Privacy Policy details our practices concerning the collection, storage, and handling of information you submit when inquiring about our courses, booking counselling sessions, or attending our training programs.
      </p>

      <h2>2. Information We Collect</h2>
      <p>When you interact with our website or submit an admission inquiry, we may collect:</p>
      <ul>
        <li>Full Name</li>
        <li>Contact Details (Telephone and WhatsApp numbers, email addresses)</li>
        <li>Educational background and English proficiency interests</li>
        <li>Feedback voluntarily submitted by registered students</li>
      </ul>

      <h2>3. Purpose of Data Use</h2>
      <p>We use the data you provide exclusively to:</p>
      <ul>
        <li>Schedule your complimentary level evaluation and counselling session</li>
        <li>Communicate curriculum updates, batch information, and schedules</li>
        <li>Respond promptly to direct queries through phone, WhatsApp, or email</li>
      </ul>

      <h2>4. Data Confidentiality &amp; Non-Disclosure</h2>
      <p>
        {name} maintains a strict zero-spam, zero-reselling policy. We never sell, lease, or distribute your personal details or contact credentials to third-party marketing entities.
      </p>

      <h2>5. Security Measures</h2>
      <p>
        We employ industry-standard organizational and technical measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction.
      </p>

      <h2>6. Contact For Privacy Matters</h2>
      <p>
        If you have any questions or wish to update or remove your contact preferences, please reach out directly:
      </p>
      <div class="privacy-contact-box">
        <p><strong>{name} Admissions Desk</strong></p>
        <p>Location: Amravati, Maharashtra</p>
        <p>Phone: {contact.phone}</p>
        <p>WhatsApp: +91 {contact.whatsappClean}</p>
        <p>Email: {contact.email}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-12) 0 var(--space-16);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--color-accent-yellow);
  }

  .privacy-content {
    max-width: 760px;
    margin: 0 auto;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .privacy-content h2 {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .privacy-content p {
    margin-bottom: var(--space-4);
  }

  .privacy-content ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .privacy-content li {
    margin-bottom: 0.35rem;
  }

  .privacy-contact-box {
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.15);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-top: var(--space-4);
  }

  .privacy-contact-box p {
    margin-bottom: 0.25rem;
  }
</style>