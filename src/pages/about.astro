---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trainer from '../components/Trainer.astro';
import Stats from '../components/Stats.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="About Us & Coach Faizan Khan"
  description="Discover the story and pedagogical philosophy of GLOBAL Institute, founded by Coach Faizan Khan to eliminate English speaking hesitation and build leaders."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">About GLOBAL Institute</span>
      <h1 class="page-title">Pioneering Conversational Mastery &amp; Leadership</h1>
      <p class="page-subtitle">
        For over 12 years, GLOBAL Institute has stood as North India's foremost center for transforming hesitant speakers into fluent corporate leaders and inspirational educators.
      </p>
    </div>
  </section>

  <!-- Stats Ribbon -->
  <Stats />

  <!-- Our Mission & Vision -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-card">
          <div class="about-icon">🎯</div>
          <h2 class="about-title">Our Mission</h2>
          <p class="about-text">
            To eradicate language hesitation and stage fear through scientifically structured, neuro-linguistic speaking drills, empowering every student with the poise to express their ideas fearlessly in global forums.
          </p>
        </div>

        <div class="about-card">
          <div class="about-icon">🌟</div>
          <h2 class="about-title">Our Vision</h2>
          <p class="about-text">
            To build a world where lack of English fluency is never a barrier to career success, executive promotions, or global leadership opportunities.
          </p>
        </div>

        <div class="about-card">
          <div class="about-icon">⚡</div>
          <h2 class="about-title">The 12-Level Method</h2>
          <p class="about-text">
            Traditional rote grammar instruction fails because conversation happens in milliseconds. Our 12-level progressive framework trains mental agility and spontaneous speech reflexes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trainer Section -->
  <Trainer />

  <!-- Enquiry Form Section -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-card {
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.15);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base);
  }

  .about-card:hover {
    transform: translateY(-4px);
  }

  .about-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .about-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-3);
  }

  .about-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>