---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="About This Starter"
  description="Architecture and guidelines for using the Astro + Bun starter template across your website projects."
>
  <div class="container about-page">
    <div class="about-page__header">
      <span class="badge-tag">Documentation</span>
      <h1>About the Starter</h1>
      <p class="about-page__subtitle">
        Engineered for rapid bootstrapping, high maintainability, and zero bloat across client and internal projects.
      </p>
    </div>

    <div class="about-page__content">
      <section class="about-section">
        <h2>Guiding Principles</h2>
        <div class="grid grid--two">
          <Card
            title="Clean Git Lineage"
            description="When spinning up a new website, start fresh from the GitHub template with an independent commit history."
          />
          <Card
            title="Locked Dependencies"
            description="Use Bun's frozen lockfile to ensure identical, deterministic builds in CI/CD and production environments."
          />
          <Card
            title="Zero Bloated Frameworks"
            description="Plain semantic HTML, CSS tokens, and optional Astro components. Bring React, Vue, or Svelte only when required."
          />
          <Card
            title="SEO by Default"
            description="Pre-wired Open Graph tags, canonical links, twitter cards, and sitemap generation save setup time on every launch."
          />
        </div>
      </section>

      <section class="about-section">
        <h2>Workflow Checklist for New Projects</h2>
        <ul class="checklist">
          <li><strong>1. Create repository:</strong> Click "Use this template" on GitHub.</li>
          <li><strong>2. Configure site URL:</strong> Update <code>PUBLIC_SITE_URL</code> in your deployment environment or <code>.env</code>.</li>
          <li><strong>3. Update metadata:</strong> Edit site titles and descriptions in <code>BaseHead.astro</code> and page frontmatter.</li>
          <li><strong>4. Install dependencies:</strong> Run <code>bun install --frozen-lockfile</code>.</li>
        </ul>
      </section>

      <div class="about-page__cta">
        <Button href="/" variant="primary" size="lg">&larr; Back to Home</Button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: var(--space-12) var(--space-4) var(--space-20);
    max-width: 800px;
  }

  .about-page__header {
    margin-bottom: var(--space-10);
  }

  .badge-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: var(--color-primary-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .about-page__subtitle {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
  }

  .about-section {
    margin-bottom: var(--space-10);
  }

  .about-section h2 {
    margin-bottom: var(--space-6);
  }

  .grid--two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .grid--two {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .checklist li {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .checklist strong {
    color: var(--color-text);
  }

  .about-page__cta {
    margin-top: var(--space-8);
  }
</style>
