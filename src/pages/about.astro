---
import BaseLayout from '../layouts/BaseLayout.astro';
import Trainer from '../components/Trainer.astro';
import Stats from '../components/Stats.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name, tagline, introduction, trainer } = siteData;
const introParagraphs = introduction.split('\n\n');
---

<BaseLayout
  title={`About Us & Coach Faizan Khan – ${name}`}
  description="Learn about Global Spoken English & Personality Development Institute in Amravati, Maharashtra. Established in 2016 by Coach Faizan Khan."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">About {name}</span>
      <h1 class="page-title">{tagline}</h1>
      <p class="page-subtitle">
        Established in 2016 in Amravati, Maharashtra — dedicated to improving communication skills, spoken English, personality development and interview readiness.
      </p>
    </div>
  </section>

  <!-- Stats Ribbon -->
  <Stats />

  <!-- Institute Introduction Section -->
  <section class="section about-intro-section">
    <div class="container">
      <div class="intro-box">
        <div class="section-header">
          <span class="section-tag">Institute Introduction</span>
          <h2 class="section-title">Welcome to <span class="highlight-yellow">{name}</span></h2>
        </div>
        <div class="intro-paragraphs">
          {introParagraphs.map((para) => (
            <p class="intro-text">{para}</p>
          ))}
        </div>
      </div>

      <!-- 3 Pillar Core Cards -->
      <div class="about-grid">
        <div class="about-card">
          <div class="about-icon">🎯</div>
          <h3 class="about-title">Our Mission</h3>
          <p class="about-text">
            To help students, graduates, job seekers, and working professionals develop the communication skills and confidence required to perform better in academic, professional, and real-world situations.
          </p>
        </div>

        <div class="about-card">
          <div class="about-icon">🌟</div>
          <h3 class="about-title">Our Vision</h3>
          <p class="about-text">
            "{trainer.vision}"
          </p>
        </div>

        <div class="about-card">
          <div class="about-icon">⚡</div>
          <h3 class="about-title">Our Training Approach</h3>
          <p class="about-text">
            Focus on practical learning, individual improvement, personalised guidance, and real-life communication practice across 12 separate learning levels.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trainer Section -->
  <Trainer />

  <!-- Enquiry Form Section -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }

  .about-intro-section {
    padding-top: var(--space-8);
  }

  .intro-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-6);
    box-shadow: 0 10px 30px rgba(11, 47, 99, 0.05);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .intro-box {
      padding: var(--space-10) var(--space-12);
    }
  }

  .intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 860px;
    margin: 0 auto;
  }

  .intro-text {
    font-size: var(--text-base);
    color: var(--color-text-main);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .about-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(11, 47, 99, 0.08);
  }

  .about-icon {
    font-size: 2.25rem;
    margin-bottom: var(--space-4);
  }

  .about-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-3);
  }

  .about-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
</style>
