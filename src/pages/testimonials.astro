---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="Student Testimonials & Transformational Journeys"
  description="Watch authentic video stories and read testimonials of students and working professionals who conquered stage fear and achieved career breakthroughs."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Proven Transformations</span>
      <h1 class="page-title">Real Stories, Real Results</h1>
      <p class="page-subtitle">
        Discover how our learners transitioned from stage nervousness to effortless conversational elegance and high-paying multinational roles.
      </p>
    </div>
  </section>

  <!-- Video Testimonials Section -->
  <VideoTestimonials />

  <!-- Selected Reviews Section -->
  <Reviews limit={6} />

  <!-- Contact / Booking -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>