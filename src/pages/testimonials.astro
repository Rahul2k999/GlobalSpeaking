---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import siteData from '../data/site.json';

const { name } = siteData;
---

<BaseLayout
  title={`Student Testimonials & Success Stories – ${name}`}
  description="Discover genuine transformations from students and professionals trained at Global Spoken English & Personality Development Institute, Amravati."
>
  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="section-tag section-tag--light">Proven Transformations</span>
      <h1 class="page-title">Student Testimonials &amp; Success Stories</h1>
      <p class="page-subtitle">
        Over 15,000 students and professionals have built confidence, improved spoken English, and prepared for careers under Coach Faizan Khan.
      </p>
    </div>
  </section>

  <!-- Video Testimonials Section -->
  <VideoTestimonials />

  <!-- Selected Reviews Section -->
  <Reviews limit={6} />

  <!-- Contact / Booking -->
  <Contact />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 70%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
  }

  .page-hero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-tag--light {
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
  }

  .page-title {
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
  }
</style>
