---
import coursesData from '../data/courses.json';

interface Props {
  showAllLink?: boolean;
}

const { showAllLink = false } = Astro.props;
---

<section class="section section--light-grey courses-section" id="courses" aria-labelledby="courses-heading">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Career-Driven Curricula</span>
      <h2 id="courses-heading" class="section-title">
        Our Flagship <span class="highlight-yellow">Programs</span>
      </h2>
      <p class="section-subtitle">
        Scientifically sequenced across 12 practical levels to take you from hesitant English speaker to poised corporate communicator.
      </p>
    </div>

    <!-- Courses Grid -->
    <div class="courses-grid">
      {coursesData.map((course) => (
        <article class="course-card" id={`course-${course.slug}`}>
          <div class="course-card__header">
            <span class="course-badge">{course.badge}</span>
            <div class="course-duration">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{course.duration}</span>
            </div>
          </div>

          <div class="course-card__body">
            <h3 class="course-title">
              <a href={`/courses/${course.slug}`}>{course.title}</a>
            </h3>
            <p class="course-tagline">{course.tagline}</p>
            <p class="course-description">{course.shortDescription}</p>

            <div class="course-features">
              <div class="features-label">Core Highlights:</div>
              <ul class="features-list">
                {course.keyFeatures.slice(0, 4).map((feature) => (
                  <li class="feature-item">
                    <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="course-card__footer">
            <a href={`/courses/${course.slug}`} class="btn btn-outline-blue course-btn">
              Explore Syllabus &rarr;
            </a>
            <a href="#enquiry-section" class="btn btn-yellow course-btn">
              Book Free Demo
            </a>
          </div>
        </article>
      ))}
    </div>

    {showAllLink && (
      <div class="courses-bottom-cta">
        <p>Looking for custom corporate training, weekend fast-tracks, or teacher placement batches?</p>
        <a href="/courses" class="btn btn-call">
          Explore Complete 12-Level System &rarr;
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .courses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .courses-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .course-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.06);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    position: relative;
  }

  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(11, 47, 99, 0.12);
    border-color: var(--color-secondary-blue);
  }

  .course-card__header {
    padding: var(--space-6) var(--space-6) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .course-badge {
    background-color: var(--color-bg-light-blue);
    color: var(--color-secondary-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(7, 87, 166, 0.2);
    letter-spacing: 0.02em;
  }

  .course-duration {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .course-card__body {
    padding: var(--space-5) var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .course-title {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .course-title a {
    color: var(--color-primary-navy);
  }

  .course-title a:hover {
    color: var(--color-secondary-blue);
  }

  .course-tagline {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-secondary-blue);
    margin-bottom: var(--space-3);
  }

  .course-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .course-features {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }

  .features-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-main);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    color: var(--color-whatsapp-green);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .course-card__footer {
    padding: var(--space-5) var(--space-6);
    background-color: var(--color-bg-light-grey);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .course-btn {
    font-size: var(--text-xs);
    padding: 0.65rem 0.5rem;
    white-space: nowrap;
    text-align: center;
  }

  .courses-bottom-cta {
    margin-top: var(--space-12);
    text-align: center;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .courses-bottom-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .courses-bottom-cta p {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }
</style>