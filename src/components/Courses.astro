---
import coursesData from '../data/courses.json';

interface Props {
  showAllLink?: boolean;
}

const { showAllLink = false } = Astro.props;
---

<section class="section section--light-grey courses-section" id="courses" aria-labelledby="courses-heading">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Career &amp; Life Skills</span>
      <h2 id="courses-heading" class="section-title">
        Our Core <span class="highlight-yellow">Courses</span>
      </h2>
      <p class="section-subtitle">
        Our training approach focuses on practical learning, individual improvement, personalised guidance, and real-life communication practice.
      </p>
    </div>

    <!-- Courses Grid -->
    <div class="courses-grid">
      {coursesData.map((course) => (
        <article class="course-card" id={`course-${course.slug}`}>
          {course.image && (
            <div class="course-card__media">
              <img
                src={course.image}
                alt={`${course.title} Training Session`}
                width="400"
                height="225"
                loading="lazy"
                class="course-card__img"
              />
            </div>
          )}

          <div class="course-card__header">
            <span class="course-badge">{course.badge}</span>
            <div class="course-duration">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{course.duration}</span>
            </div>
          </div>

          <div class="course-card__body">
            <h3 class="course-title">
              <a href={`/courses/${course.slug}`}>{course.title}</a>
            </h3>
            <p class="course-tagline">{course.tagline}</p>
            <p class="course-description">{course.shortDescription}</p>

            <div class="course-features">
              <div class="features-label">Key Focus Areas:</div>
              <ul class="features-list">
                {course.keyFocusAreas.map((feature) => (
                  <li class="feature-item">
                    <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="course-card__footer">
            <a href={`/courses/${course.slug}`} class="btn btn-outline-blue course-btn">
              Explore Course &rarr;
            </a>
            <a href="#enquiry-section" class="btn btn-yellow course-btn">
              Enquire Now
            </a>
          </div>
        </article>
      ))}
    </div>

    {showAllLink && (
      <div class="courses-bottom-cta">
        <p>We assess each candidate's current level before recommending the most suitable course and learning path.</p>
        <a href="/courses" class="btn btn-call">
          Explore All Course Pathways &rarr;
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .courses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .courses-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .course-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.1);
  }

  .course-card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-5);
    background-color: var(--color-bg-light-blue);
  }

  .course-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .course-card:hover .course-card__img {
    transform: scale(1.04);
  }

  .course-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .course-badge {
    background-color: var(--color-bg-light-blue);
    color: var(--color-secondary-blue);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .course-duration {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #64748B;
  }

  .course-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .course-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.25rem;
  }

  .course-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .course-title a:hover {
    color: var(--color-secondary-blue);
  }

  .course-tagline {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-secondary-blue);
    margin-bottom: var(--space-3);
  }

  .course-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .course-features {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .features-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-6);
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: var(--leading-normal);
  }

  .check-icon {
    width: 15px;
    height: 15px;
    color: #20B45B;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .course-card__footer {
    display: flex;
    gap: var(--space-3);
  }

  .course-btn {
    flex: 1;
    text-align: center;
    padding: 0.6rem 0.5rem;
    font-size: var(--text-xs);
  }

  .courses-bottom-cta {
    margin-top: var(--space-12);
    text-align: center;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .courses-bottom-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .courses-bottom-cta p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: 600;
    margin: 0;
  }
</style>
