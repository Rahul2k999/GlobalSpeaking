---
import achievementsData from '../data/achievements.json';

interface Props {
  showMilestones?: boolean;
}

const { showMilestones = true } = Astro.props;
const { milestones, awards, careersSection, eventPhotos, achievementPhotos } = achievementsData;

const milestoneIcons: Record<string, string> = {
  trophy: "🏆",
  briefcase: "💼",
  group: "🎓"
};
---

<section class="section section--light-grey achievements-section" id="achievements" aria-labelledby={showMilestones ? 'achievements-heading' : 'honours-heading'}>
  <div class="container">
    {showMilestones && (
    <div class="section-header">
      <span class="section-tag">Track Record of Success</span>
      <h2 id="achievements-heading" class="section-title">
        Our <span class="highlight-yellow">Achievements</span>
      </h2>
      <p class="section-subtitle">
        Tangible results and institutional milestones reflecting our commitment to empowering students, graduates, and working professionals in Amravati.
      </p>
    </div>

    <!-- Milestones 3 Columns -->
    <div class="milestones-grid">
      {milestones.map((m) => (
        <div class="milestone-card">
          <div class="milestone-icon-wrap">
            <span class="milestone-icon">{milestoneIcons[m.icon] || "🏆"}</span>
          </div>
          <div class="milestone-value">{m.value}</div>
          <h3 class="milestone-title">{m.title}</h3>
          <p class="milestone-sub">{m.subtitle}</p>
          <p class="milestone-desc">{m.description}</p>
        </div>
      ))}
    </div>
    )}

    <!-- National Awards & Recognitions Bar -->
    <div class="awards-container">
      <div class="awards-header">
        <span class="awards-tag">Honours &amp; Accolades</span>
        <h3 id="honours-heading" class="awards-main-title">Prestigious Recognitions Awarded to Coach Faizan Khan</h3>
      </div>
      <div class="awards-grid">
        {awards.map((award) => (
          <div class="award-card">
            <div class="award-year-badge">{award.year}</div>
            <div class="award-card__body">
              <h4 class="award-title">{award.title}</h4>
              <p class="award-sub">{award.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Coach Photos (Honours & Accolades) -->
    <div class="achievement-photos-grid">
      {achievementPhotos.map((src, idx) => (
        <figure class="achievement-photo-card">
          <img
            src={src}
            alt={`Coach Faizan Khan award and event photograph ${idx + 1}`}
            width="1000"
            height="707"
            loading="lazy"
            class="achievement-photo-img"
          />
        </figure>
      ))}
    </div>

    <!-- Events & Activity -->
    {eventPhotos && eventPhotos.length > 0 && (
      <div class="event-photos-container">
        <div class="section-header">
          <h3 class="section-title">Events &amp; <span class="highlight-yellow">Activity</span></h3>
        </div>
        <div class="event-photos-grid event-photos-grid--six">
          {eventPhotos.map((item, idx) => (
            <figure class="event-photo-card">
              <div class="event-photo-wrap">
                <img
                  src={item.image}
                  alt={`Institute event and activity photograph ${idx + 1}`}
                  width="900"
                  height="675"
                  loading="lazy"
                  class="event-photo-img"
                />
              </div>
            </figure>
          ))}
        </div>
      </div>
    )}

    <!-- Corporate Candidates Placement Companies -->
    <div class="corporate-section">
      <div class="corporate-header">
        <span class="section-tag">{careersSection.subtitle}</span>
        <h3 class="corporate-title">{careersSection.title}</h3>
        <p class="corporate-disclaimer">
          {careersSection.disclaimer}
        </p>
      </div>

      <div class="company-logos-wrap">
        <img
          src={careersSection.logoImage}
          alt="Logos of organisations where trained candidates are working"
          width="1200"
          height="675"
          loading="lazy"
          class="company-logos-img"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .milestones-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .milestones-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .milestone-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-5) var(--space-4);
    text-align: center;
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (min-width: 640px) {
    .milestone-card {
      padding: var(--space-8);
    }
  }

  .milestone-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.1);
  }

  .milestone-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--color-bg-light-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  .milestone-icon {
    font-size: 1.75rem;
  }

  .milestone-value {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 900;
    color: var(--color-primary-navy);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .milestone-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-secondary-blue);
    margin-bottom: 0.35rem;
  }

  .milestone-sub {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-yellow);
    background-color: var(--color-deep-navy);
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .milestone-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Awards Section */
  .awards-container {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 100%);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-4);
    color: #FFFFFF;
    margin-bottom: var(--space-12);
    box-shadow: 0 12px 30px rgba(11, 47, 99, 0.12);
  }

  @media (min-width: 640px) {
    .awards-container {
      padding: var(--space-8);
    }
  }

  .awards-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .awards-tag {
    display: inline-block;
    background-color: rgba(255, 201, 40, 0.15);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .awards-main-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: #FFFFFF;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .awards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .award-card {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--transition-base);
  }

  .award-card:hover {
    transform: translateY(-3px);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .award-year-badge {
    align-self: flex-start;
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
  }

  .award-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .award-sub {
    font-size: var(--text-xs);
    color: #CBD5E1;
    line-height: var(--leading-normal);
  }

  /* Event Photos Visual Showcase */
  .event-photos-container {
    margin-bottom: var(--space-12);
  }

  .event-photos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .event-photos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .event-photo-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin: 0;
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.06);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .event-photo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.12);
  }

  .event-photo-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg-light-blue);
  }

  .event-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .event-photo-card:hover .event-photo-img {
    transform: scale(1.03);
  }

  .event-photo-caption {
    padding: var(--space-6);
  }

  .event-photo-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-2);
  }

  .event-photo-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Corporate Section */
  .corporate-section {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-4);
    margin-bottom: var(--space-12);
    box-shadow: 0 6px 20px rgba(11, 47, 99, 0.04);
  }

  @media (min-width: 640px) {
    .corporate-section {
      padding: var(--space-8);
    }
  }

  .corporate-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-8);
  }

  .corporate-title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 900;
    color: var(--color-primary-navy);
    margin: var(--space-2) 0 var(--space-2);
  }

  .corporate-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-card {
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
  }

  .category-header {
    border-bottom: 2px solid var(--color-secondary-blue);
    padding-bottom: 0.4rem;
    margin-bottom: var(--space-4);
  }

  .category-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-primary-navy);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .companies-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .company-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-text-main);
    font-weight: 600;
  }

  .company-bullet {
    color: var(--color-secondary-blue);
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Highlights Box */
  .highlights-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-navy);
  }

  .highlight-icon {
    width: 20px;
    height: 20px;
    color: #20B45B;
    flex-shrink: 0;
  }

  .achievement-photos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .achievement-photos-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .achievement-photos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .achievement-photo-card {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-light-blue);
  }

  .achievement-photo-img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 768px) {
    .achievement-photo-img {
      height: 220px;
    }
  }

  .event-photos-grid--six {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 768px) {
    .event-photos-grid--six {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .company-logos-wrap {
    width: 100%;
  }

  .company-logos-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
  }
</style>
