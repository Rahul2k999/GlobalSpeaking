---
import siteData from '../data/site.json';
import EnquiryForm from './EnquiryForm.astro';

const { contact, branches, name, socials } = siteData;
---

<section class="section section--light-grey contact-section" id="enquiry-section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Direct Admissions &amp; Support</span>
      <h2 id="contact-heading" class="section-title">
        Contact &amp; <span class="highlight-yellow">Locations</span>
      </h2>
      <p class="section-subtitle">
        Visit any of our two training branches in Amravati or connect with us on Phone, WhatsApp, or Email for individual level assessment and course guidance.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left Column: Branches & Direct Contact Info -->
      <div class="contact-info-col">
        <div class="info-card">
          <h3 class="info-card__title">Visit Our Branches</h3>
          <p class="info-card__sub">
            {name} operates two premier training branches in Amravati, Maharashtra. We assess each candidate's current level before recommending the most suitable course.
          </p>

          <!-- Branch 1 & Branch 2 Separate Cards -->
          <div class="branches-wrapper">
            {branches.map((branch, idx) => (
              <div class="branch-card" id={branch.id}>
                <div class="branch-card__header">
                  <span class="branch-badge">Branch 0{idx + 1}</span>
                  <h4 class="branch-name">{branch.name}</h4>
                </div>
                <p class="branch-address">{branch.address}</p>
                <div class="branch-actions">
                  <a 
                    href={branch.mapUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline-blue btn-sm branch-map-btn"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>View on Google Maps</span>
                    <span class="external-arrow">&rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Direct Helpline Box -->
          <div class="info-items-list">
            <!-- Phone -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--navy">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">Primary Phone Helpline</div>
                <a href={`tel:${contact.phoneClean}`} class="info-item__link">{contact.phone}</a>
                <div class="info-item__hint">Direct Admissions Line</div>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--green">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">WhatsApp Enquiries</div>
                <a 
                  href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(contact.whatsappMessage)}`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="info-item__link"
                >
                  {contact.whatsapp}
                </a>
                <div class="info-item__hint">Instant message support</div>
              </div>
            </div>

            <!-- Email -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--blue">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">Official Email</div>
                <a href={`mailto:${contact.email}`} class="info-item__link info-item__link--email">
                  {contact.email}
                </a>
                <div class="info-item__hint">Admissions &amp; Academic Communication</div>
              </div>
            </div>
          </div>

          <!-- Social media links -->
          <div class="contact-socials-box">
            <span class="contact-socials-label">Follow &amp; Review Us:</span>
            <div class="contact-socials-row">
              {socials.map((s) => (
                <a 
                  href={s.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="contact-social-btn"
                  title={s.platform}
                >
                  {s.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  )}
                  {s.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                  )}
                  {s.icon === 'google' && (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
                    </svg>
                  )}
                  <span>{s.platform}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Validated Form -->
      <div class="contact-form-col">
        <EnquiryForm />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-bg-light-grey);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-10);
    }
  }

  .info-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.05);
  }

  .info-card__title {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
  }

  .info-card__sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    line-height: var(--leading-relaxed);
  }

  /* Branches Wrapper */
  .branches-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .branch-card {
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .branch-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(11, 47, 99, 0.08);
  }

  .branch-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .branch-badge {
    background-color: var(--color-primary-navy);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .branch-name {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin: 0;
  }

  .branch-address {
    font-size: var(--text-sm);
    color: var(--color-text-main);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-3);
  }

  .branch-map-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
  }

  .external-arrow {
    transition: transform 0.2s ease;
  }

  .branch-map-btn:hover .external-arrow {
    transform: translateX(3px);
  }

  /* Contact Items List */
  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .info-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .info-item__icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-item__icon--navy {
    background-color: rgba(11, 47, 99, 0.08);
    color: var(--color-primary-navy);
  }

  .info-item__icon--green {
    background-color: rgba(32, 180, 91, 0.1);
    color: #20B45B;
  }

  .info-item__icon--blue {
    background-color: rgba(7, 87, 166, 0.08);
    color: var(--color-secondary-blue);
  }

  .info-item__label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-item__link {
    display: block;
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    text-decoration: none;
    margin-top: 0.15rem;
  }

  .info-item__link:hover {
    color: var(--color-secondary-blue);
    text-decoration: underline;
  }

  .info-item__link--email {
    font-size: var(--text-sm);
    word-break: break-all;
  }

  .info-item__hint {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: 0.15rem;
  }

  /* Socials box */
  .contact-socials-box {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .contact-socials-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .contact-socials-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    background-color: var(--color-bg-light-blue);
    border: 1px solid rgba(7, 87, 166, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-primary-navy);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }

  .contact-social-btn:hover {
    background-color: var(--color-secondary-blue);
    color: #FFFFFF;
    border-color: var(--color-secondary-blue);
  }
</style>
