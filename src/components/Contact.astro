---
import siteData from '../data/site.json';
import EnquiryForm from './EnquiryForm.astro';

const { contact } = siteData;
---

<section class="section section--light-grey contact-section" id="enquiry-section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Direct Admissions &amp; Support</span>
      <h2 id="contact-heading" class="section-title">
        Contact &amp; <span class="highlight-yellow">Enquiry</span>
      </h2>
      <p class="section-subtitle">
        Have questions about our 12 levels, fee structure, or demo batches? Speak directly with our senior counsellors.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left Column: Campus Info & Map -->
      <div class="contact-info-col">
        <div class="info-card">
          <h3 class="info-card__title">Visit Our Institute Campus</h3>
          <p class="info-card__sub">We welcome students and parents for campus walkthroughs and free speaking evaluations.</p>

          <div class="info-items-list">
            <!-- Address -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--blue">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">Campus Location</div>
                <div class="info-item__val">{contact.address}</div>
                <div class="info-item__hint">Landmark: {contact.landmark} ({contact.city})</div>
              </div>
            </div>

            <!-- Phone -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--navy">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">Call Direct Admissions</div>
                <a href={`tel:${contact.phoneClean}`} class="info-item__link">{contact.phone}</a>
                <div class="info-item__hint">Mon – Sat: 8:00 AM – 8:00 PM</div>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="info-item">
              <div class="info-item__icon info-item__icon--green">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <div class="info-item__label">Instant WhatsApp Desk</div>
                <a 
                  href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(contact.whatsappMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="info-item__link"
                >
                  Chat with Coach on WhatsApp
                </a>
                <div class="info-item__hint">Typical response within 10 minutes</div>
              </div>
            </div>
          </div>

          <!-- Google Map Embed Container -->
          <div class="map-embed-wrap">
            <iframe
              src={contact.mapEmbedUrl}
              title="GLOBAL Institute Campus Map"
              width="100%"
              height="240"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Validated Form -->
      <div class="contact-form-col">
        <EnquiryForm />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-bg-light-grey);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .info-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.05);
  }

  .info-card__title {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
  }

  .info-card__sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    line-height: var(--leading-normal);
  }

  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .info-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .info-item__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-item__icon--blue {
    background-color: var(--color-bg-light-blue);
    color: var(--color-secondary-blue);
  }

  .info-item__icon--navy {
    background-color: #EEF2F6;
    color: var(--color-primary-navy);
  }

  .info-item__icon--green {
    background-color: #EAF7EE;
    color: var(--color-whatsapp-green);
  }

  .info-item__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .info-item__val {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-navy);
    line-height: 1.35;
  }

  .info-item__link {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-secondary-blue);
    display: block;
    line-height: 1.3;
  }

  .info-item__link:hover {
    color: var(--color-primary-navy);
  }

  .info-item__hint {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .map-embed-wrap {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
</style>