---
import videosData from '../data/videos.json';
import siteData from '../data/site.json';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const { name, socials } = siteData;
const instagram = socials.find(s => s.platform === 'Instagram');

const allTestimonials = videosData.testimonials || [];
const displayTestimonials = limit
  ? allTestimonials.filter(t => t.homepage).slice(0, limit)
  : allTestimonials;
---

<section class="section section--deep-navy video-testimonials-section" id="video-testimonials" aria-labelledby="video-testimonials-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Student Transformations</span>
      <h2 id="video-testimonials-heading" class="section-title">
        Student <span class="highlight-yellow">Video Testimonials</span>
      </h2>
      <p class="section-subtitle">
        Real stories from students, graduates, and working professionals who built confidence and speaking fluency at {name}.
      </p>
    </div>

    <div class="video-carousel" data-carousel>
      <button type="button" class="carousel-nav carousel-nav--prev" data-carousel-dir="prev" aria-label="Previous testimonial">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <div class="carousel-viewport">
        <div class="carousel-track">
          <div class="carousel-group">
            {displayTestimonials.map((item) => (
              <article class="testimonial-card">
                <div
                  class="video-preview-wrapper"
                  data-video-url={item.videoUrl}
                  data-video-title={item.student}
                  role="button"
                  tabindex="0"
                  aria-label={`Play video testimonial: ${item.student}`}
                >
                  <img
                    src={item.thumbnail}
                    alt={item.student}
                    width="480"
                    height="480"
                    loading="lazy"
                    class="video-poster"
                  />
                  <div class="video-overlay">
                    <button type="button" class="play-btn" aria-label="Play Video" tabindex="-1">
                      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                    <span class="video-duration">{item.duration}</span>
                  </div>
                </div>

                <div class="testimonial-info">
                  <h3 class="testimonial-name">{item.student}</h3>
                </div>
              </article>
            ))}
          </div>

          <div class="carousel-group" aria-hidden="true">
            {displayTestimonials.map((item) => (
              <article class="testimonial-card">
                <div
                  class="video-preview-wrapper"
                  data-video-url={item.videoUrl}
                  data-video-title={item.student}
                  role="button"
                  tabindex="-1"
                >
                  <img
                    src={item.thumbnail}
                    alt=""
                    width="480"
                    height="480"
                    loading="lazy"
                    class="video-poster"
                  />
                  <div class="video-overlay">
                    <button type="button" class="play-btn" tabindex="-1" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                    <span class="video-duration">{item.duration}</span>
                  </div>
                </div>

                <div class="testimonial-info">
                  <h3 class="testimonial-name">{item.student}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <button type="button" class="carousel-nav carousel-nav--next" data-carousel-dir="next" aria-label="Next testimonial">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>

    <div class="testimonials-footer">
      {instagram && (
        <a
          href={instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-yellow btn-lg"
        >
          <span>Watch on Instagram &rarr;</span>
        </a>
      )}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-carousel]').forEach((root) => {
      const track = root.querySelector('.carousel-track');
      const group = root.querySelector('.carousel-group');
      if (!track || !group) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const speed = 24; // pixels per second - slow and subtle
      let x = 0;
      let last = 0;

      const groupWidth = () => group.getBoundingClientRect().width || 1;
      const stepWidth = () => {
        const card = group.querySelector('.testimonial-card');
        if (!card) return 300;
        const gap = parseFloat(getComputedStyle(group).gap) || 0;
        return card.getBoundingClientRect().width + gap;
      };
      const wrap = () => {
        const w = groupWidth();
        while (x <= -w) x += w;
        while (x > 0) x -= w;
      };
      const draw = () => {
        track.style.transform = `translate3d(${x}px, 0, 0)`;
      };
      const isPaused = () =>
        reduceMotion ||
        root.matches(':hover') ||
        root.querySelector('.carousel-viewport').contains(document.activeElement) ||
        document.body.classList.contains('video-modal-active');

      const frame = (time) => {
        if (!last) last = time;
        const delta = Math.min((time - last) / 1000, 0.1);
        last = time;
        if (!isPaused()) {
          x -= speed * delta;
          wrap();
          draw();
        }
        requestAnimationFrame(frame);
      };

      root.querySelectorAll('[data-carousel-dir]').forEach((btn) => {
        btn.addEventListener('click', () => {
          x += btn.getAttribute('data-carousel-dir') === 'next' ? -stepWidth() : stepWidth();
          wrap();
          draw();
        });
      });

      wrap();
      draw();
      requestAnimationFrame(frame);
    });
  });
</script>

<style>
  .video-testimonials-section {
    background-color: var(--color-deep-navy);
    color: #FFFFFF;
  }

  .video-carousel {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin-bottom: var(--space-12);
  }

  .carousel-viewport {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .carousel-group {
    display: flex;
    flex: 0 0 auto;
    gap: var(--space-8);
    padding-right: var(--space-8);
  }

  .testimonial-card {
    flex: 0 0 auto;
    width: 360px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 201, 40, 0.4);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 1023px) {
    .testimonial-card {
      width: 320px;
    }
  }

  @media (max-width: 640px) {
    .testimonial-card {
      width: min(86vw, 360px);
    }
  }

  .video-preview-wrapper {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #051429;
  }

  .video-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .video-preview-wrapper:hover .video-poster {
    transform: scale(1.03);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 29, 61, 0.6) 0%, transparent 60%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(255, 201, 40, 0.4);
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .video-preview-wrapper:hover .play-btn {
    transform: scale(1.12);
    background-color: #FFD452;
  }

  .play-btn svg {
    margin-left: 3px;
  }

  .video-duration {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: rgba(0, 0, 0, 0.75);
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .testimonial-info {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 640px) {
    .testimonial-info {
      padding: var(--space-5);
    }
  }

  .testimonial-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: var(--space-2);
  }

  .testimonials-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    align-items: center;
  }

  @media (max-width: 540px) {
    .testimonials-footer {
      flex-direction: column;
    }
    .testimonials-footer .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .carousel-nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 5;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 201, 40, 0.45);
    background-color: rgba(7, 29, 61, 0.85);
    color: var(--color-accent-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .carousel-nav:hover {
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
  }

  .carousel-nav--prev {
    left: -6px;
  }

  .carousel-nav--next {
    right: -6px;
  }

  @media (max-width: 640px) {
    .carousel-nav {
      width: 32px;
      height: 32px;
      top: 40%;
    }
    .carousel-nav--prev {
      left: -2px;
    }
    .carousel-nav--next {
      right: -2px;
    }
  }
</style>
