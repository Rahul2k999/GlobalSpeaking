---
import siteData from '../data/site.json';

const { name, socials, contact } = siteData;
const googleReview = socials.find(s => s.platform === 'Google Reviews');
---

<section class="section section--deep-navy video-testimonials-section" id="video-testimonials" aria-labelledby="video-testimonials-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Student Transformations</span>
      <h2 id="video-testimonials-heading" class="section-title">
        Student <span class="highlight-yellow">Testimonials</span>
      </h2>
      <p class="section-subtitle">
        Real stories from students, graduates, and working professionals who built confidence and speaking fluency at {name}.
      </p>
    </div>

    <!-- Verified Testimonials Gateway Card -->
    <div class="testimonials-placeholder-card">
      <div class="placeholder-icon">🎓</div>
      <h3 class="placeholder-title">Student Stories &amp; Testimonials</h3>
      <p class="placeholder-desc">
        Authentic video testimonials and speaking transformation recordings from our recent batches are currently being curated and will be published soon. In the meantime, you can explore verified student feedback directly on our official Google Business page.
      </p>
      <div class="placeholder-actions">
        {googleReview && (
          <a 
            href={googleReview.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-yellow btn-lg"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
            </svg>
            <span>Read Verified Google Reviews &rarr;</span>
          </a>
        )}
        <a 
          href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent('Hello Global Spoken English, I would like to enquire about course admissions.')}`}
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-whatsapp btn-lg"
        >
          <span>Connect on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .video-testimonials-section {
    background-color: var(--color-deep-navy);
    color: #FFFFFF;
  }

  .testimonials-placeholder-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-2xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .placeholder-icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }

  .placeholder-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: var(--space-3);
  }

  .placeholder-desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .placeholder-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
