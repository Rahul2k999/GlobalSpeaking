---
import videosData from '../data/videos.json';
import siteData from '../data/site.json';

interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit, showAllLink = false } = Astro.props;
const { name, socials, contact } = siteData;
const googleReview = socials.find(s => s.platform === 'Google Reviews');

const allTestimonials = videosData.testimonials || [];
const displayTestimonials = limit
  ? allTestimonials.filter(t => t.homepage).slice(0, limit)
  : allTestimonials;
---

<section class="section section--deep-navy video-testimonials-section" id="video-testimonials" aria-labelledby="video-testimonials-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Student Transformations</span>
      <h2 id="video-testimonials-heading" class="section-title">
        Student <span class="highlight-yellow">Video Testimonials</span>
      </h2>
      <p class="section-subtitle">
        Real stories from students, graduates, and working professionals who built confidence and speaking fluency at {name}.
      </p>
    </div>

    <!-- Video Testimonials Grid -->
    <div class="testimonials-grid">
      {displayTestimonials.map((item) => (
        <article class="testimonial-card">
          <div 
            class="video-preview-wrapper"
            data-video-url={item.videoUrl}
            data-video-title={`${item.student} – ${item.course}`}
            role="button"
            tabindex="0"
            aria-label={`Play video testimonial: ${item.student}`}
          >
            <img
              src={item.thumbnail}
              alt={item.student}
              width="480"
              height="480"
              loading="lazy"
              class="video-poster"
            />
            <div class="video-overlay">
              <button type="button" class="play-btn" aria-label="Play Video" tabindex="-1">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
              <span class="video-duration">{item.duration}</span>
            </div>
          </div>

          <div class="testimonial-info">
            <span class="testimonial-badge">{item.course}</span>
            <h3 class="testimonial-name">{item.student}</h3>
            <p class="testimonial-quote">"{item.quote}"</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Actions & Links -->
    <div class="testimonials-footer">
      {showAllLink && (
        <a href="/testimonials" class="btn btn-outline-yellow btn-lg">
          <span>Watch All Student Stories &rarr;</span>
        </a>
      )}

      {googleReview && (
        <a 
          href={googleReview.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-yellow btn-lg"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <span>Read Verified Google Reviews &rarr;</span>
        </a>
      )}

      <a 
        href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent('Hello Global Spoken English, I would like to enquire about course admissions.')}`}
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-whatsapp btn-lg"
      >
        <span>Connect on WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<style>
  .video-testimonials-section {
    background-color: var(--color-deep-navy);
    color: #FFFFFF;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonial-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 201, 40, 0.4);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.3);
  }

  .video-preview-wrapper {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: #051429;
  }

  .video-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .video-preview-wrapper:hover .video-poster {
    transform: scale(1.03);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 29, 61, 0.6) 0%, transparent 60%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(255, 201, 40, 0.4);
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .video-preview-wrapper:hover .play-btn {
    transform: scale(1.12);
    background-color: #FFD452;
  }

  .play-btn svg {
    margin-left: 3px;
  }

  .video-duration {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: rgba(0, 0, 0, 0.75);
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .testimonial-info {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 640px) {
    .testimonial-info {
      padding: var(--space-5);
    }
  }

  .testimonial-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-yellow);
    background: rgba(255, 201, 40, 0.12);
    border: 1px solid rgba(255, 201, 40, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .testimonial-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: var(--space-2);
  }

  .testimonial-quote {
    font-size: var(--text-sm);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    font-style: italic;
    margin: 0;
  }

  .testimonials-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    align-items: center;
  }

  @media (max-width: 540px) {
    .testimonials-footer {
      flex-direction: column;
    }
    .testimonials-footer .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .btn-outline-yellow {
    border: 2px solid var(--color-accent-yellow);
    color: var(--color-accent-yellow);
    background: transparent;
  }

  .btn-outline-yellow:hover {
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
  }
</style>
