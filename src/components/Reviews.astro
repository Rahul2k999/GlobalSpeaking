---
import reviewsData from '../data/reviews.json';
import siteData from '../data/site.json';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const { googleReviewsUrl, badge, headline, description, actionText, reviews } = reviewsData;
const { name } = siteData;

const displayReviews = limit ? reviews.slice(0, limit) : reviews;
---

<section class="section section--light-blue reviews-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{badge}</span>
      <h2 id="reviews-heading" class="section-title">
        Google <span class="highlight-yellow">Reviews</span>
      </h2>
      <p class="section-subtitle">
        Real experiences and verified reviews from students, graduates, and professionals trained at {name}.
      </p>
    </div>

    <!-- Verified Review Cards Grid -->
    {displayReviews && displayReviews.length > 0 && (
      <div class="reviews-grid">
        {displayReviews.map((rev) => (
          <article class="review-item-card">
            {rev.image && (
              <div class="review-screenshot-wrap">
                <img
                  src={rev.image}
                  alt={`Google review by ${rev.author}`}
                  width="400"
                  height="160"
                  loading="lazy"
                  class="review-screenshot-img"
                />
              </div>
            )}
            <div class="review-item-body">
              <div class="review-meta">
                <div class="review-author-wrap">
                  <span class="review-author">{rev.author}</span>
                  <span class="review-time">{rev.time}</span>
                </div>
                <div class="review-stars" aria-label={`${rev.rating} out of 5 stars`}>
                  {"★".repeat(rev.rating)}
                </div>
              </div>
              <p class="review-comment">"{rev.comment}"</p>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Official Google Reviews Showcase Card -->
    <div class="google-reviews-card">
      <div class="google-reviews-card__content">
        <div class="google-brand-header">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor" class="google-icon">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <div class="google-header-text">
            <h3 class="google-reviews-title">{headline}</h3>
            <span class="google-reviews-tag">Verified Public Business Reviews</span>
          </div>
        </div>

        <p class="google-reviews-desc">
          {description}
        </p>

        <div class="google-reviews-pillars">
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>100% Genuine Public Google Reviews</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>Real Student Feedback &amp; Success Stories</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>Transparent Ratings on Google Maps</span>
          </div>
        </div>

        <div class="google-reviews-action">
          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-yellow btn-lg google-cta-btn"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
            </svg>
            <span>{actionText} &rarr;</span>
          </a>

          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-call btn-lg"
          >
            <span>Write a Google Review</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: var(--color-bg-light-blue);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-item-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(7, 87, 166, 0.12);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(11, 47, 99, 0.06);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .review-item-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(11, 47, 99, 0.12);
  }

  .review-screenshot-wrap {
    width: 100%;
    background-color: #F8FAFC;
    border-bottom: 1px solid rgba(7, 87, 166, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
  }

  .review-screenshot-img {
    max-width: 100%;
    height: auto;
    max-height: 140px;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .review-item-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .review-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-3);
  }

  .review-author-wrap {
    display: flex;
    flex-direction: column;
  }

  .review-author {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary-navy);
  }

  .review-time {
    font-size: var(--text-xs);
    color: #64748B;
  }

  .review-stars {
    color: var(--color-accent-yellow);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .review-comment {
    font-size: var(--text-sm);
    color: #334155;
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
  }

  .google-reviews-card {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 100%);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    color: #FFFFFF;
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 860px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .google-reviews-card {
      padding: var(--space-12);
    }
  }

  .google-brand-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .google-icon {
    color: var(--color-accent-yellow);
    flex-shrink: 0;
  }

  .google-reviews-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  .google-reviews-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .google-reviews-desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .google-reviews-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-8);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  @media (min-width: 640px) {
    .google-reviews-pillars {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .pillar-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #EEF5FD;
  }

  .pillar-check {
    color: #20B45B;
    font-weight: 900;
  }

  .google-reviews-action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
