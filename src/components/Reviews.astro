---
import reviewsData from '../data/reviews.json';
import siteData from '../data/site.json';

interface Props {
  limit?: number;
}

const { googleReviewsUrl, badge, headline, description, actionText } = reviewsData;
const { name } = siteData;
---

<section class="section section--light-blue reviews-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{badge}</span>
      <h2 id="reviews-heading" class="section-title">
        Google <span class="highlight-yellow">Reviews</span>
      </h2>
      <p class="section-subtitle">
        Real experiences and verified reviews from students, graduates, and professionals trained at {name}.
      </p>
    </div>

    <!-- Official Google Reviews Showcase Card -->
    <div class="google-reviews-card">
      <div class="google-reviews-card__content">
        <div class="google-brand-header">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor" class="google-icon">
            <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
          </svg>
          <div class="google-header-text">
            <h3 class="google-reviews-title">{headline}</h3>
            <span class="google-reviews-tag">Verified Public Business Reviews</span>
          </div>
        </div>

        <p class="google-reviews-desc">
          {description}
        </p>

        <div class="google-reviews-pillars">
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>100% Genuine Public Google Reviews</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>Real Student Feedback &amp; Success Stories</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-check">✓</span>
            <span>Transparent Ratings on Google Maps</span>
          </div>
        </div>

        <div class="google-reviews-action">
          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-yellow btn-lg google-cta-btn"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
            </svg>
            <span>{actionText} &rarr;</span>
          </a>

          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-call btn-lg"
          >
            <span>Write a Google Review</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: var(--color-bg-light-blue);
  }

  .google-reviews-card {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 100%);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    color: #FFFFFF;
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 860px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .google-reviews-card {
      padding: var(--space-12);
    }
  }

  .google-brand-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .google-icon {
    color: var(--color-accent-yellow);
    flex-shrink: 0;
  }

  .google-reviews-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  .google-reviews-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .google-reviews-desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .google-reviews-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-8);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  @media (min-width: 640px) {
    .google-reviews-pillars {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .pillar-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #EEF5FD;
  }

  .pillar-check {
    color: #20B45B;
    font-weight: 900;
  }

  .google-reviews-action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .google-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
