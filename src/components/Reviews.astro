---
import reviewsData from '../data/reviews.json';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const { rating, maxRating, totalReviews, platform, badge, reviews } = reviewsData;
const displayReviews = limit ? reviews.slice(0, limit) : reviews;
---

<section class="section section--light-blue reviews-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{badge}</span>
      <h2 id="reviews-heading" class="section-title">
        Student <span class="highlight-yellow">Reviews</span>
      </h2>
      <p class="section-subtitle">
        Real feedback from working professionals, college graduates, and educators who transformed their lives at GLOBAL Institute.
      </p>
    </div>

    <!-- Rating Summary Banner -->
    <div class="rating-banner">
      <div class="rating-banner__score">
        <span class="score-number">{rating}</span>
        <span class="score-max">/{maxRating}</span>
      </div>
      <div class="rating-banner__details">
        <div class="rating-stars">★★★★★</div>
        <div class="rating-count">Based on <strong>{totalReviews}</strong> {platform}</div>
      </div>
      <div class="rating-banner__badge">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="#20B45B">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>100% Genuine Student Feedback</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="reviews-grid">
      {displayReviews.map((rev) => (
        <article class="review-card">
          <div class="review-card__header">
            <img
              src={rev.avatar}
              alt={rev.name}
              width="48"
              height="48"
              loading="lazy"
              class="review-avatar"
            />
            <div class="review-meta">
              <h3 class="review-name">{rev.name}</h3>
              <p class="review-role">{rev.role}</p>
              <span class="review-batch">{rev.batch}</span>
            </div>
          </div>

          <div class="review-card__rating">
            <span class="stars">{'★'.repeat(rev.rating)}</span>
            <span class="review-date">{rev.date}</span>
          </div>

          <p class="review-content">"{rev.content}"</p>

          <div class="review-verified">
            <svg viewBox="0 0 20 20" width="14" height="14" fill="#20B45B">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Verified Student Review</span>
          </div>
        </article>
      ))}
    </div>

    <div class="reviews-footer-action">
      <a href="/reviews" class="btn btn-call">
        Read All {totalReviews} Student Reviews &rarr;
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: var(--color-bg-light-blue);
  }

  /* Rating Summary Banner */
  .rating-banner {
    background-color: #FFFFFF;
    border: 1px solid rgba(7, 87, 166, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    box-shadow: 0 8px 24px rgba(11, 47, 99, 0.06);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .rating-banner {
      flex-direction: row;
    }
  }

  .rating-banner__score {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .score-number {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 900;
    color: var(--color-primary-navy);
    line-height: 1;
  }

  .score-max {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    font-weight: 700;
  }

  .rating-banner__details {
    text-align: center;
  }

  @media (min-width: 768px) {
    .rating-banner__details {
      text-align: left;
    }
  }

  .rating-stars {
    color: #F59E0B;
    letter-spacing: 2px;
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .rating-count {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .rating-banner__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #EAF7EE;
    color: var(--color-whatsapp-green);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
  }

  /* Grid */
  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 6px 18px rgba(11, 47, 99, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(11, 47, 99, 0.08);
  }

  .review-card__header {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin-bottom: var(--space-3);
  }

  .review-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .review-name {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .review-role {
    font-size: 0.68rem;
    color: var(--color-secondary-blue);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .review-batch {
    display: block;
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  .review-card__rating {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .stars {
    color: #F59E0B;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
  }

  .review-date {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .review-content {
    font-size: var(--text-xs);
    color: var(--color-text-main);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .review-verified {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    color: var(--color-whatsapp-green);
    font-weight: 700;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
  }

  .reviews-footer-action {
    margin-top: var(--space-10);
    text-align: center;
  }
</style>