---
import siteData from '../data/site.json';
import coursesData from '../data/courses.json';

const { contact, name } = siteData;
---

<div class="enquiry-card" id="enquiry-form-container">
  <div class="enquiry-card__header">
    <span class="enquiry-tag">Admissions Enquiry</span>
    <h3 class="enquiry-title">Enquire &amp; Book Counselling</h3>
    <p class="enquiry-desc">
      Fill out the details below to connect directly with {name} admissions on WhatsApp for personalised guidance.
    </p>
  </div>

  <form id="enquiry-form" class="enquiry-form" data-whatsapp={contact.whatsappClean} novalidate>
    <!-- Full Name -->
    <div class="form-group">
      <label for="fullName" class="form-label">Full Name <span class="required">*</span></label>
      <input
        type="text"
        id="fullName"
        name="fullName"
        class="form-input"
        placeholder="e.g. Rahul Sharma"
        required
      />
      <span class="form-error" id="nameError">Please enter your full name.</span>
    </div>

    <!-- Mobile Number -->
    <div class="form-group">
      <label for="phone" class="form-label">Mobile Number <span class="required">*</span></label>
      <div class="input-with-prefix">
        <span class="input-prefix">+91</span>
        <input
          type="tel"
          id="phone"
          name="phone"
          class="form-input form-input--prefixed"
          placeholder="98765 43210"
          maxlength="10"
          required
        />
      </div>
      <span class="form-error" id="phoneError">Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9.</span>
    </div>

    <!-- Interested Course -->
    <div class="form-group">
      <label for="courseSelect" class="form-label">Interested Course <span class="required">*</span></label>
      <select id="courseSelect" name="course" class="form-select" required>
        <option value="" disabled selected>-- Choose Interested Course --</option>
        {coursesData.map((c) => (
          <option value={c.title}>{c.title} ({c.duration})</option>
        ))}
        <option value="All Courses / Personalized Counselling">All Courses / Personalized Counselling</option>
      </select>
      <span class="form-error" id="courseError">Please select an interested course.</span>
    </div>

    <!-- Current Education / Profession -->
    <div class="form-group">
      <label for="educationProfession" class="form-label">Current Education / Profession <span class="required">*</span></label>
      <input
        type="text"
        id="educationProfession"
        name="educationProfession"
        class="form-input"
        placeholder="e.g. College Student, Graduate, Working Professional, Teacher"
        required
      />
      <span class="form-error" id="eduError">Please enter your current education or profession.</span>
    </div>

    <!-- Preferred Contact Time -->
    <div class="form-group">
      <label for="contactTime" class="form-label">Preferred Contact Time <span class="required">*</span></label>
      <select id="contactTime" name="contactTime" class="form-select" required>
        <option value="Morning (9:00 AM – 12:00 PM)">Morning (9:00 AM – 12:00 PM)</option>
        <option value="Afternoon (12:00 PM – 4:00 PM)">Afternoon (12:00 PM – 4:00 PM)</option>
        <option value="Evening (4:00 PM – 8:00 PM)" selected>Evening (4:00 PM – 8:00 PM)</option>
        <option value="Any Time (During Working Hours)">Any Time (During Working Hours)</option>
      </select>
    </div>

    <!-- Submit Buttons -->
    <div class="form-actions">
      <button type="submit" class="btn btn-yellow btn-lg form-submit-btn" id="submitBtn">
        <span>Send Enquiry via WhatsApp</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>

      <button type="button" class="btn btn-whatsapp form-whatsapp-btn" id="whatsappSubmitBtn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Instant WhatsApp Direct Chat</span>
      </button>
    </div>

    <!-- Success Message Banner -->
    <div class="form-success" id="formSuccessMessage">
      <div class="success-icon">✓</div>
      <div>
        <h4 class="success-title">Opening WhatsApp...</h4>
        <p class="success-desc">Your enquiry is formatted and opening directly in WhatsApp. You can also reach us directly at <strong>{contact.phone}</strong>.</p>
      </div>
    </div>
  </form>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('enquiry-form');
    const whatsappNumber = form?.getAttribute('data-whatsapp') || '919637339536';
    const nameInput = document.getElementById('fullName');
    const phoneInput = document.getElementById('phone');
    const courseSelect = document.getElementById('courseSelect');
    const eduInput = document.getElementById('educationProfession');
    const timeSelect = document.getElementById('contactTime');

    const nameError = document.getElementById('nameError');
    const phoneError = document.getElementById('phoneError');
    const courseError = document.getElementById('courseError');
    const eduError = document.getElementById('eduError');
    const successBox = document.getElementById('formSuccessMessage');
    const whatsappBtn = document.getElementById('whatsappSubmitBtn');

    function validate() {
      let isValid = true;

      // Full Name check (minimum 2 letters)
      if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
        nameError.style.display = 'block';
        isValid = false;
      } else {
        nameError.style.display = 'none';
      }

      // Mobile Number check: Indian 10 digits starting with 6-9
      const cleanPhone = phoneInput.value.replace(/\D/g, '');
      const phoneRegex = /^[6-9]\d{9}$/;
      if (!phoneRegex.test(cleanPhone)) {
        phoneError.style.display = 'block';
        isValid = false;
      } else {
        phoneError.style.display = 'none';
      }

      // Course check
      if (!courseSelect.value) {
        courseError.style.display = 'block';
        isValid = false;
      } else {
        courseError.style.display = 'none';
      }

      // Current Education / Profession check
      if (!eduInput.value.trim()) {
        eduError.style.display = 'block';
        isValid = false;
      } else {
        eduError.style.display = 'none';
      }

      return isValid;
    }

    function sendToWhatsApp() {
      if (!validate()) return;

      const name = nameInput.value.trim();
      const phone = phoneInput.value.replace(/\D/g, '');
      const course = courseSelect.value;
      const education = eduInput.value.trim();
      const contactTime = timeSelect.value;

      const message = `Hello Global Spoken English,

I would like to enquire about course admission:

*Name:* ${name}
*Mobile Number:* ${phone}
*Interested Course:* ${course}
*Current Education / Profession:* ${education}
*Preferred Contact Time:* ${contactTime}`;

      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

      // Show friendly confirmation
      if (successBox) {
        successBox.style.display = 'flex';
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Open WhatsApp in new tab
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        sendToWhatsApp();
      });
    }

    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', (e) => {
        e.preventDefault();
        sendToWhatsApp();
      });
    }
  });
</script>

<style>
  .enquiry-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-5) var(--space-4);
    box-shadow: 0 16px 36px rgba(11, 47, 99, 0.08);
  }

  @media (min-width: 640px) {
    .enquiry-card {
      padding: var(--space-8);
    }
  }

  .enquiry-card__header {
    margin-bottom: var(--space-6);
  }

  .enquiry-tag {
    display: inline-block;
    background-color: #FFF9E6;
    color: #B45309;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(245, 158, 11, 0.3);
    margin-bottom: var(--space-2);
  }

  .enquiry-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--color-primary-navy);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .enquiry-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .required {
    color: #DC2626;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 0.95rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: #FFFFFF;
    color: var(--color-text-main);
    font-size: var(--text-sm);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-secondary-blue);
    box-shadow: 0 0 0 3px rgba(7, 87, 166, 0.12);
  }

  .input-with-prefix {
    display: flex;
    align-items: center;
  }

  .input-prefix {
    background-color: var(--color-bg-light-grey);
    border: 1.5px solid var(--color-border);
    border-right: none;
    padding: 0.75rem 0.85rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .form-input--prefixed {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .form-error {
    font-size: 0.72rem;
    color: #DC2626;
    font-weight: 600;
    display: none;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .form-submit-btn,
  .form-whatsapp-btn {
    width: 100%;
  }

  .form-success {
    display: none;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: #EAF7EE;
    border: 1px solid rgba(32, 180, 91, 0.4);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-top: var(--space-2);
  }

  .success-icon {
    width: 28px;
    height: 28px;
    background-color: var(--color-whatsapp-green);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    flex-shrink: 0;
  }

  .success-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: #166534;
    margin-bottom: 2px;
  }

  .success-desc {
    font-size: var(--text-xs);
    color: #15803D;
    line-height: var(--leading-normal);
    margin: 0;
  }
</style>