---
import siteData from '../data/site.json';

const { subSlogan, contact, establishedText, name } = siteData;
---

<section class="hero-section" aria-label={`Welcome to ${name}`}>
  <div class="hero-section__backdrop">
    <div class="hero-circle hero-circle--1"></div>
    <div class="hero-circle hero-circle--2"></div>
  </div>

  <div class="container hero-section__inner">
    <!-- Left Column: Compelling Copy & CTAs -->
    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge__dot"></span>
        <span>{establishedText} • Amravati<span class="hide-xs">, Maharashtra</span></span>
      </div>

      <h1 class="hero-title">
        Where Your Next
        <span class="hero-title__highlight">Version Begins</span>
      </h1>

      <p class="hero-subtitle">
        {subSlogan}
      </p>

      <p class="hero-tagline-desc">
        Global Spoken English &amp; Personality Development Institute is dedicated to improving communication skills, spoken English, personality development and interview readiness. Under the direct mentorship of <strong>Coach Faizan Khan</strong>, we assess each candidate's current level to recommend the ideal learning path.
      </p>

      <!-- Key Proof Points / Highlights -->
      <div class="hero-proof-grid">
        <div class="proof-item">
          <div class="proof-number">15,000+</div>
          <div class="proof-label">Students Trained</div>
        </div>
        <div class="proof-divider"></div>
        <div class="proof-item">
          <div class="proof-number">1,700+</div>
          <div class="proof-label">MNC Selections</div>
        </div>
        <div class="proof-divider"></div>
        <div class="proof-item">
          <div class="proof-number">1,000+</div>
          <div class="proof-label">Teachers Placed</div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#enquiry-section" class="btn btn-yellow btn-lg hero-btn-main">
          <span>Book Free Demo Class</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a href={`tel:${contact.phoneClean}`} class="btn btn-call btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
          </svg>
          <span>Call: {contact.phone}</span>
        </a>

        <a 
          href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(contact.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp btn-lg"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>WhatsApp Now</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust">
        <div class="trust-rating">
          <span class="stars">🎖️</span>
          <span class="rating-text">Recipient of <strong>Bharat Bhushan Award 2025</strong></span>
        </div>
        <span class="trust-dot">•</span>
        <span class="trust-guarantee">Practical Learning &amp; Personalized Guidance</span>
      </div>
    </div>

    <!-- Right Column: Visual Stage Graphic -->
    <div class="hero-visual">
      <div class="hero-visual__wrapper">
        <div class="hero-image-frame">
          <picture>
            <source srcset="/images/hero-faizan-stage.webp" type="image/webp" />
            <img
              src="/images/hero-faizan-stage.webp"
              alt="Coach Faizan Khan conducting live communication session at Global Spoken English"
              width="480"
              height="580"
              loading="eager"
              fetchpriority="high"
              class="hero-photo"
            />
          </picture>
          <div class="hero-trainer-pill">
            <span class="hero-pill-badge">Director &amp; Chief Coach</span>
            <span class="hero-pill-name">Coach Faizan Khan</span>
          </div>
        </div>

        <!-- Floating Card 1 -->
        <div class="hero-float-card hero-float-card--top">
          <div class="float-icon">🎯</div>
          <div>
            <div class="float-title">12 Separate Levels</div>
            <div class="float-sub">For Every Age &amp; Profession</div>
          </div>
        </div>

        <!-- Floating Card 2 -->
        <div class="hero-float-card hero-float-card--bottom">
          <div class="float-icon float-icon--green">✓</div>
          <div>
            <div class="float-title">Practical Learning</div>
            <div class="float-sub">Real-Life Speaking Practice</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 60%, #0757A6 100%);
    color: #FFFFFF;
    padding: var(--space-12) 0 var(--space-16);
    overflow: hidden;
    contain: paint;
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: var(--space-20) 0 var(--space-24);
    }
  }

  /* Backdrop decorative circles */
  .hero-section__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }

  .hero-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    max-width: 100vw;
  }

  .hero-circle--1 {
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(255, 201, 40, 0.15) 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }

  .hero-circle--2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(7, 87, 166, 0.35) 0%, transparent 70%);
    bottom: -100px;
    left: -100px;
  }

  .hero-section__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-section__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
  }

  /* Left Hero Content */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 201, 40, 0.15);
    border: 1px solid rgba(255, 201, 40, 0.35);
    color: var(--color-accent-yellow);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
    letter-spacing: 0.02em;
    max-width: 100%;
  }

  @media (max-width: 380px) {
    .hero-badge {
      font-size: 0.72rem;
      padding: 0.35rem 0.75rem;
      gap: 0.35rem;
    }
  }

  .hero-badge__dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent-yellow);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-accent-yellow);
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 6.5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-title__highlight {
    display: inline-block;
    color: var(--color-accent-yellow);
    position: relative;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    font-weight: 700;
    color: #EEF5FD;
    margin-bottom: var(--space-4);
    line-height: 1.3;
  }

  .hero-tagline-desc {
    font-size: var(--text-base);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    max-width: 620px;
    margin-bottom: var(--space-8);
  }

  .hero-tagline-desc strong {
    color: #FFFFFF;
  }

  /* Proof Grid */
  .hero-proof-grid {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    max-width: 580px;
    width: 100%;
    margin-bottom: var(--space-8);
  }

  @media (max-width: 480px) {
    .hero-proof-grid {
      padding: var(--space-3) var(--space-2);
      gap: var(--space-2);
      margin-bottom: var(--space-6);
    }
  }

  .proof-item {
    flex: 1;
    text-align: center;
  }

  .proof-number {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.5vw, 1.75rem);
    font-weight: 900;
    color: var(--color-accent-yellow);
    line-height: 1.1;
  }

  .proof-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #CBD5E1;
    margin-top: 2px;
  }

  @media (max-width: 480px) {
    .proof-label {
      font-size: 0.68rem;
    }
  }

  .proof-divider {
    width: 1px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 540px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: #CBD5E1;
  }

  .trust-rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .stars {
    color: var(--color-accent-yellow);
    letter-spacing: 2px;
    font-size: 0.9rem;
  }

  .trust-dot {
    color: rgba(255, 255, 255, 0.4);
  }

  .trust-guarantee {
    color: #86EFAC;
    font-weight: 600;
  }

  /* Right Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-visual__wrapper {
    position: relative;
    max-width: 480px;
    width: 100%;
  }

  .hero-image-frame {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 201, 40, 0.4);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(7, 29, 61, 0.8) 100%);
  }

  .hero-photo {
    width: 100%;
    height: auto;
    max-height: 540px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hero-image-frame:hover .hero-photo {
    transform: scale(1.02);
  }

  .hero-trainer-pill {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    background: rgba(7, 29, 61, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 201, 40, 0.3);
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-pill-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-pill-name {
    font-size: var(--text-base);
    font-weight: 800;
    color: #FFFFFF;
  }

  /* Floating Badges */
  .hero-float-card {
    position: absolute;
    background-color: #FFFFFF;
    color: var(--color-primary-navy);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    animation: pulseSubtle 4s infinite ease-in-out;
  }

  .hero-float-card--top {
    top: -12px;
    left: 0;
  }

  .hero-float-card--bottom {
    bottom: -15px;
    right: 0;
    animation-delay: 2s;
  }

  .float-icon {
    font-size: 1.25rem;
    width: 34px;
    height: 34px;
    background-color: var(--color-bg-light-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
  }

  .float-icon--green {
    background-color: #EAF7EE;
    color: var(--color-whatsapp-green);
    font-weight: 900;
  }

  .float-title {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-primary-navy);
  }

  .float-sub {
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hero-float-card {
      display: none;
    }
  }
</style>