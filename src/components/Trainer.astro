---
import siteData from '../data/site.json';

interface Props {
  showWhyChoose?: boolean;
}

const { showWhyChoose = true } = Astro.props;
const { trainer, whyChooseUs } = siteData;

const whyIcons: Record<string, string> = {
  expert: "👨‍🏫",
  practical: "🗣️",
  levels: "📈",
  counselling: "🎯"
};
---

<section class="section trainer-section" id="trainer" aria-labelledby="trainer-heading">
  <div class="container">
    <!-- Trainer Profile Showcase -->
    <div class:list={['trainer-card', { 'trainer-card--standalone': !showWhyChoose }]}>
      <div class="trainer-card__grid">
        <!-- Trainer Photo / Badge Column -->
        <div class="trainer-card__media">
          <div class="trainer-image-wrap">
            <picture>
              <source srcset="/images/trainer-faizan-portrait-2026.webp" type="image/webp" />
              <img
                src="/images/trainer-faizan-portrait-2026.webp"
                alt={`${trainer.name} - ${trainer.designation}`}
                width="1000"
                height="1333"
                loading="lazy"
                class="trainer-photo"
              />
            </picture>
            <div class="experience-pill">
              <span class="exp-number">Director</span>
              <span class="exp-text">Global Spoken English</span>
            </div>
          </div>
        </div>

        <!-- Trainer Content Column -->
        <div class="trainer-card__content">
          <div class="section-tag section-tag--blue">Director &amp; Chief Coach</div>
          <h2 id="trainer-heading" class="trainer-name">{trainer.name}</h2>

          <div class="trainer-final-bio">
            {trainer.finalBio.map((line) => (
              <p class="trainer-bio-line">{line}</p>
            ))}
          </div>

        </div>
      </div>
    </div>

    {showWhyChoose && (
      <div class="why-choose-wrap">
      <div class="section-header">
        <span class="section-tag">{whyChooseUs.subtitle}</span>
        <h3 class="section-title">
          {whyChooseUs.title.split('Global')[0]}
          <span class="highlight-yellow">Global Spoken English?</span>
        </h3>
        <p class="section-subtitle">
          Our learner-focused training approach helps students and professionals improve the way they speak, present themselves, communicate, and perform in real-life situations.
        </p>
      </div>

      <div class="why-grid">
        {whyChooseUs.points.map((point) => (
          <div class="why-card">
            <div class="why-card__icon">{whyIcons[point.icon] || "⭐"}</div>
            <h4 class="why-card__title">{point.title}</h4>
            <p class="why-card__desc">{point.description}</p>
          </div>
        ))}
      </div>
      </div>
    )}
  </div>
</section>

<style>
  .trainer-section {
    background-color: #FFFFFF;
  }

  .trainer-card {
    background: linear-gradient(135deg, #071D3D 0%, #0B2F63 100%);
    color: #FFFFFF;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(11, 47, 99, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-20);
  }

  .trainer-card--standalone {
    margin-bottom: 0;
  }

  .trainer-card__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .trainer-card__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .trainer-card__media {
    background-color: rgba(7, 87, 166, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    position: relative;
    height: 100%;
  }

  @media (min-width: 640px) {
    .trainer-card__media {
      padding: var(--space-8);
    }
  }

  .trainer-image-wrap {
    position: relative;
    max-width: 380px;
    width: 100%;
  }

  .trainer-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    display: block;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .experience-pill {
    position: absolute;
    bottom: -10px;
    right: 10px;
    background-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 2px solid #FFFFFF;
  }

  @media (min-width: 640px) {
    .experience-pill {
      bottom: -15px;
      right: 15px;
      padding: var(--space-3) var(--space-5);
    }
  }

  .exp-number {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .exp-text {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .trainer-card__content {
    padding: var(--space-6) var(--space-4);
  }

  @media (min-width: 640px) {
    .trainer-card__content {
      padding: var(--space-8) var(--space-6);
    }
  }

  @media (min-width: 768px) {
    .trainer-card__content {
      padding: var(--space-12) var(--space-10);
    }
  }

  .section-tag--blue {
    background-color: rgba(7, 87, 166, 0.35);
    color: #EEF5FD;
    border: 1px solid rgba(7, 87, 166, 0.6);
  }

  .trainer-name {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 900;
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
    line-height: 1.15;
  }

  .trainer-final-bio {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .trainer-bio-line {
    font-size: var(--text-sm);
    color: #CBD5E1;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .trainer-bio-line:first-child {
    color: #FFFFFF;
    font-weight: 600;
  }

  /* Vision Box */
  .trainer-vision-box {
    background-color: rgba(255, 201, 40, 0.08);
    border-left: 3px solid var(--color-accent-yellow);
    padding: var(--space-3) var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: var(--space-5);
  }

  .vision-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.2rem;
  }

  .vision-text {
    font-size: var(--text-sm);
    font-style: italic;
    color: #EEF5FD;
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Awards */
  .trainer-awards-section {
    margin-bottom: var(--space-5);
  }

  .awards-badge-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .award-badge-card {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.75rem;
  }

  .award-badge-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .award-badge-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent-yellow);
  }

  .award-badge-desc {
    display: block;
    font-size: 0.72rem;
    color: #CBD5E1;
  }

  /* Expertise */
  .trainer-expertise-section {
    margin-bottom: var(--space-5);
  }

  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .expertise-tag {
    background-color: rgba(7, 87, 166, 0.3);
    border: 1px solid rgba(7, 87, 166, 0.5);
    color: #EEF5FD;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .credentials-heading {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .credentials-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-6);
  }

  .cred-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: #CBD5E1;
    line-height: var(--leading-normal);
  }

  .cred-icon {
    width: 14px;
    height: 14px;
    color: var(--color-accent-yellow);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trainer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 540px) {
    .trainer-actions {
      flex-direction: column;
    }
    .trainer-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Why Choose Us Grid */
  .why-choose-wrap {
    padding-top: var(--space-6);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-4);
    box-shadow: 0 4px 14px rgba(11, 47, 99, 0.04);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (min-width: 640px) {
    .why-card {
      padding: var(--space-6);
    }
  }

  .why-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(11, 47, 99, 0.08);
  }

  .why-card__icon {
    font-size: 2rem;
    margin-bottom: var(--space-3);
  }

  .why-card__title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: var(--space-2);
  }

  .why-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
