---
import siteData from '../data/site.json';
import coursesData from '../data/courses.json';

const currentYear = new Date().getFullYear();
const { contact, name, tagline, branches, socials } = siteData;
---

<footer class="site-footer">
  <!-- Main Footer Content -->
  <div class="site-footer__main">
    <div class="container site-footer__grid">
      <!-- Col 1: Institute Brand & Identity -->
      <div class="footer-col footer-col--brand">
        <a href="/" class="footer-brand">
          <img src="/images/logo.png" alt="GLOBAL SPOKEN ENGLISH Logo" width="42" height="40" class="footer-brand__img" />
          <div class="footer-brand__text">
            <span class="footer-brand__name">{name}</span>
            <span class="footer-brand__tagline">{tagline}</span>
          </div>
        </a>

        <p class="footer-description">
          Professional training institute based in Amravati, Maharashtra, dedicated to improving communication skills, spoken English, personality development, and interview readiness.
        </p>

        <div class="footer-badges">
          <span class="footer-badge">Estd. 2016</span>
          <span class="footer-badge">15,000+ Alumni</span>
          <span class="footer-badge">1,700+ MNC Placed</span>
          <span class="footer-badge">1,000+ Teachers Placed</span>
        </div>

        <!-- Social Media Links -->
        <div class="footer-socials">
          <span class="footer-socials__title">Connect With Us:</span>
          <div class="footer-social-icons">
            {socials.map((s) => (
              <a 
                href={s.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="footer-social-link" 
                aria-label={`Visit our ${s.platform}`}
                title={s.platform}
              >
                {s.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                )}
                {s.icon === 'facebook' && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                )}
                {s.icon === 'google' && (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
                  </svg>
                )}
                <span>{s.platform}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Col 2: Our Programs -->
      <div class="footer-col">
        <h4 class="footer-heading">Our Courses</h4>
        <ul class="footer-links">
          {coursesData.map((course) => (
            <li>
              <a href={`/courses/${course.slug}`} class="footer-link">
                {course.title}
                <span class="footer-link__tag">{course.tagline}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/courses" class="footer-link footer-link--highlight">
              View All 12 Learning Levels &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Quick Navigation -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/about" class="footer-link">About Coach Faizan &amp; Institute</a></li>
          <li><a href="/achievements" class="footer-link">Milestones &amp; Placements</a></li>
          <li><a href="/gallery" class="footer-link">Campus Life &amp; Events Gallery</a></li>
          <li><a href="/testimonials" class="footer-link">Student Success Stories</a></li>
          <li><a href="/reviews" class="footer-link">Google Verified Reviews</a></li>
          <li><a href="/contact" class="footer-link">Contact &amp; Branch Directions</a></li>
          <li><a href="/privacy-policy" class="footer-link">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Both Branches & Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Institute Branches</h4>
        <div class="footer-contact-info">
          {branches.map((b) => (
            <div class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <div>
                <p class="contact-text-bold">{b.name}</p>
                <p class="contact-text">{b.address}</p>
                <a href={b.mapUrl} target="_blank" rel="noopener noreferrer" class="branch-map-link">
                  View on Google Maps &rarr;
                </a>
              </div>
            </div>
          ))}

          <div class="contact-item contact-item--helpline">
            <svg class="contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
            </svg>
            <div>
              <a href={`tel:${contact.phoneClean}`} class="contact-phone">{contact.phone}</a>
              <span class="contact-text-sub">Call / WhatsApp: {contact.whatsapp}</span>
              <a href={`mailto:${contact.email}`} class="footer-email-link">{contact.email}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal & Copyright Bar -->
  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} {name}. All Rights Reserved. Where Your Next Version Begins.
      </p>

      <div class="footer-legal-links">
        <a href="/privacy-policy" class="legal-link">Privacy Policy</a>
        <span class="legal-divider">•</span>
        <a href="/contact" class="legal-link">Admissions Enquiry</a>
        <span class="legal-divider">•</span>
        <a href="/contact#enquiry-form" class="legal-link">Book Free Demo</a>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Floating Contact Bar -->
  <aside class="mobile-sticky-bar" aria-label="Quick Contact Actions">
    <a href={`tel:${contact.phoneClean}`} class="mobile-sticky-btn mobile-sticky-btn--call">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
      </svg>
      <span>Call Now</span>
    </a>

    <a 
      href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(contact.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-sticky-btn mobile-sticky-btn--whatsapp"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <a href="/contact#enquiry-form" class="mobile-sticky-btn mobile-sticky-btn--demo">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
      <span>Free Demo</span>
    </a>
  </aside>
</footer>

<style>
  .site-footer {
    background-color: var(--color-deep-navy);
    color: #CBD5E1;
    margin-top: auto;
  }

  .site-footer__main {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: var(--space-8);
    }
  }

  /* Brand Column */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .footer-brand__img {
    width: 42px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer-socials {
    margin-top: var(--space-6);
  }

  .footer-socials__title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #CBD5E1;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    color: #CBD5E1;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .footer-social-link:hover {
    background-color: var(--color-accent-yellow);
    border-color: var(--color-accent-yellow);
    color: var(--color-primary-navy);
  }

  .branch-map-link {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-yellow);
    text-decoration: underline;
    margin-top: 0.25rem;
  }

  .branch-map-link:hover {
    color: #FFFFFF;
  }

  .contact-text-bold {
    font-size: var(--text-sm);
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.15rem;
  }

  .contact-item--helpline {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-email-link {
    display: block;
    font-size: var(--text-xs);
    color: #94A3B8;
    margin-top: 0.2rem;
    word-break: break-all;
  }

  .footer-email-link:hover {
    color: var(--color-accent-yellow);
  }

  .footer-brand__name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.35rem;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .footer-brand__tagline {
    display: block;
    font-size: 0.72rem;
    color: var(--color-accent-yellow);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-description {
    font-size: var(--text-sm);
    color: #94A3B8;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-badge {
    display: inline-block;
    background-color: rgba(255, 201, 40, 0.12);
    color: var(--color-accent-yellow);
    border: 1px solid rgba(255, 201, 40, 0.3);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  /* Headings & Links */
  .footer-heading {
    font-size: var(--text-base);
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 3px;
    background-color: var(--color-accent-yellow);
    border-radius: 2px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    font-size: var(--text-sm);
    color: #CBD5E1;
    text-decoration: none;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
  }

  .footer-link:hover {
    color: var(--color-accent-yellow);
    transform: translateX(3px);
  }

  .footer-link__tag {
    font-size: 0.72rem;
    color: #64748B;
  }

  .footer-link--highlight {
    color: var(--color-accent-yellow);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  /* Contact Items */
  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .contact-icon {
    color: var(--color-accent-yellow);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-text {
    font-size: var(--text-sm);
    color: #CBD5E1;
    line-height: var(--leading-normal);
  }

  .contact-text-sub {
    font-size: var(--text-xs);
    color: #94A3B8;
  }

  .contact-phone {
    display: block;
    font-size: var(--text-base);
    font-weight: 800;
    color: #FFFFFF;
  }

  .contact-phone:hover {
    color: var(--color-accent-yellow);
  }

  /* Bottom Bar */
  .site-footer__bottom {
    padding: var(--space-6) 0;
    font-size: var(--text-xs);
    color: #64748B;
  }

  .site-footer__bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    text-align: center;
  }

  @media (min-width: 640px) {
    .site-footer__bottom-inner {
      flex-direction: row;
      text-align: left;
    }
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .legal-link {
    color: #94A3B8;
  }

  .legal-link:hover {
    color: var(--color-accent-yellow);
  }

  .legal-divider {
    color: rgba(255, 255, 255, 0.2);
  }

  /* Mobile Sticky Floating Quick Actions */
  .mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    background-color: var(--color-deep-navy);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.25);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  @media (min-width: 768px) {
    .mobile-sticky-bar {
      display: none;
    }
  }

  .mobile-sticky-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem 0.3rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #FFFFFF;
    text-align: center;
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    min-width: 0;
    white-space: nowrap;
  }

  @media (max-width: 360px) {
    .mobile-sticky-btn {
      font-size: 0.68rem;
      padding: 0.65rem 0.2rem;
      gap: 0.2rem;
    }
    .mobile-sticky-btn svg {
      width: 15px;
      height: 15px;
    }
  }

  .mobile-sticky-btn--call {
    background-color: var(--color-secondary-blue);
  }

  .mobile-sticky-btn--whatsapp {
    background-color: var(--color-whatsapp-green);
  }

  .mobile-sticky-btn--demo {
    background-color: var(--color-accent-yellow);
    color: var(--color-deep-navy);
    border-right: none;
  }
</style>