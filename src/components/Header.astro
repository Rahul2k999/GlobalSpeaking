---
import siteData from '../data/site.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navLinks = siteData.navLinks;
const { contact, tagline, establishedText } = siteData;
---

<header class="site-header">
  <!-- Top announcement & quick contact bar -->
  <div class="site-header__topbar">
    <div class="container site-header__topbar-inner">
      <div class="topbar-left">
        <span class="topbar-item">
          <svg class="topbar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          <strong>{establishedText}</strong><span class="topbar-city"> • Amravati, Maharashtra</span>
        </span>
        <span class="topbar-divider">|</span>
        <a href={`mailto:${contact.email}`} class="topbar-link hide-mobile">
          <svg class="topbar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>{contact.email}</span>
        </a>
      </div>

      <div class="topbar-right">
        <a href={`tel:${contact.phoneClean}`} class="topbar-link">
          <svg class="topbar-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.22 2.09z"/>
          </svg>
          <span>Call: {contact.phone}</span>
        </a>
        <a 
          href={`https://wa.me/${contact.whatsappClean}?text=${encodeURIComponent(contact.whatsappMessage)}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="topbar-whatsapp"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>WhatsApp<span class="hide-xs"> Us</span></span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="site-header__main">
    <div class="container site-header__inner">
      <a href="/" class="site-header__brand" aria-label="GLOBAL SPOKEN ENGLISH Home">
        <img src="/images/logo.png" alt="GLOBAL SPOKEN ENGLISH Logo" width="46" height="44" class="brand-logo-img" />
        <div class="brand-text">
          <div class="brand-name">
            <span class="brand-name-main">GLOBAL</span>
            <span class="brand-name-sub">SPOKEN ENGLISH</span>
          </div>
          <div class="brand-sub">{tagline}</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="site-nav" aria-label="Primary Navigation">
        <ul class="site-nav__list">
          {navLinks.map((link) => {
            const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['site-nav__link', { 'site-nav__link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Desktop Header CTA -->
      <div class="site-header__actions">
        <a href="/contact#enquiry-form" class="btn btn-yellow site-header__cta">
          Book Free Demo
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-label="Open mobile menu"
          aria-controls="mobile-drawer"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Slide Drawer -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer__overlay" id="mobile-drawer-overlay"></div>
    <div class="mobile-drawer__content">
      <div class="mobile-drawer__header">
        <div class="brand-header-flex">
          <img src="/images/logo.png" alt="GLOBAL SPOKEN ENGLISH Logo" width="38" height="36" class="brand-logo-img-sm" />
          <div class="brand-text">
            <div class="brand-name">
              <span class="brand-name-main">GLOBAL</span>
              <span class="brand-name-sub">SPOKEN ENGLISH</span>
            </div>
          </div>
        </div>
        <button type="button" class="mobile-drawer__close" id="mobile-drawer-close" aria-label="Close menu">
          &times;
        </button>
      </div>

      <nav class="mobile-drawer__nav" aria-label="Mobile Navigation">
        <ul class="mobile-drawer__list">
          {navLinks.map((link) => {
            const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['mobile-drawer__link', { 'mobile-drawer__link--active': isActive }]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="mobile-drawer__footer">
        <div class="mobile-drawer__info">
          <p class="mobile-drawer__info-item">
            <span class="mobile-drawer__info-icon">📍</span>
            <span>Amravati, Maharashtra</span>
          </p>
          <a href={`mailto:${contact.email}`} class="mobile-drawer__email">
            ✉️ {contact.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const overlay = document.getElementById('mobile-drawer-overlay');
  const drawer = document.getElementById('mobile-drawer');

  function openDrawer() {
    if (drawer && toggleBtn) {
      drawer.classList.add('mobile-drawer--open');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (drawer && toggleBtn) {
      drawer.classList.remove('mobile-drawer--open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

  // Close when clicking any nav link inside drawer
  const drawerLinks = drawer?.querySelectorAll('.mobile-drawer__link');
  drawerLinks?.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('mobile-drawer--open')) {
      closeDrawer();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: #FFFFFF;
    box-shadow: 0 2px 12px rgba(11, 47, 99, 0.08);
  }

  /* Top Bar */
  .site-header__topbar {
    background-color: var(--color-deep-navy);
    color: #EEF5FD;
    font-size: var(--text-xs);
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-header__topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .topbar-left, .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .topbar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .topbar-item strong {
    color: var(--color-accent-yellow);
  }

  .topbar-divider {
    color: rgba(255, 255, 255, 0.25);
  }

  .topbar-link {
    color: #EEF5FD;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .topbar-link:hover {
    color: var(--color-accent-yellow);
  }

  .topbar-whatsapp {
    color: #25D366;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .topbar-whatsapp:hover {
    color: #4ade80;
  }

  @media (max-width: 768px) {
    .hide-mobile {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .topbar-left {
      display: none !important;
    }
    .site-header__topbar-inner {
      justify-content: center;
    }
    .topbar-right {
      justify-content: center;
      width: 100%;
      gap: var(--space-4);
    }
  }

  @media (max-width: 380px) {
    .hide-xs {
      display: none !important;
    }
    .topbar-right {
      gap: var(--space-3);
      font-size: 0.72rem;
    }
  }

  /* Main Nav */
  .site-header__main {
    height: 4.5rem;
    display: flex;
    align-items: center;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    min-width: 0;
  }

  /* Brand */
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .brand-logo-img {
    width: 44px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-logo-img-sm {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-header-flex {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .brand-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--color-primary-navy);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .brand-name-main {
    color: var(--color-primary-navy);
  }

  .brand-name-sub {
    color: var(--color-secondary-blue);
    font-weight: 800;
  }

  .brand-sub {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 580px) {
    .site-header__main {
      height: 4.15rem;
    }

    .brand-logo-img {
      width: 38px;
      height: 36px;
    }

    .site-header__brand {
      gap: 0.5rem;
    }

    .brand-name {
      font-size: 1.05rem;
      line-height: 1.12;
      white-space: normal;
    }

    .brand-name-sub {
      display: block;
      font-size: 0.76rem;
      letter-spacing: 0.02em;
    }

    .brand-sub {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .site-header__inner {
      gap: 0.35rem;
    }

    .brand-logo-img {
      width: 32px;
      height: 32px;
    }

    .brand-name {
      font-size: 0.92rem;
    }

    .brand-name-sub {
      font-size: 0.7rem;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .site-header__cta {
    display: none;
  }

  @media (min-width: 768px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  /* Hamburger Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.45rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-bar {
    width: 100%;
    height: 2.5px;
    background-color: var(--color-primary-navy);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Mobile Slide Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 200;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.3s ease;
  }

  .mobile-drawer--open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 29, 61, 0.6);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer--open .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__content {
    position: absolute;
    top: 0;
    right: 0;
    width: 82%;
    max-width: 340px;
    height: 100%;
    background-color: #FFFFFF;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    padding: var(--space-6);
  }

  .mobile-drawer--open .mobile-drawer__content {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .mobile-drawer__close {
    background: transparent;
    border: none;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-text-main);
    cursor: pointer;
    padding: 0 0.5rem;
  }

  .mobile-drawer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-drawer__link {
    display: block;
    padding: 0.65rem 0.75rem;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-main);
    border-radius: var(--radius-md);
    transition: all 0.2s;
  }

  .mobile-drawer__link:hover,
  .mobile-drawer__link--active {
    background-color: var(--color-bg-light-blue);
    color: var(--color-secondary-blue);
  }

  .mobile-drawer__footer {
    margin-top: auto;
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .mobile-drawer__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-drawer__info-item {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .mobile-drawer__info-icon {
    font-size: 0.9rem;
  }

  .mobile-drawer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-secondary-blue);
    word-break: break-all;
    text-decoration: none;
    font-weight: 600;
  }

  .mobile-drawer__email:hover {
    text-decoration: underline;
  }
</style>