---
import galleryData from '../data/gallery.json';

interface Props {
  limit?: number;
  showFilters?: boolean;
  showAllLink?: boolean;
}

const { limit = 6, showAllLink = false } = Astro.props;
const { items } = galleryData;
const displayItems = limit ? items.slice(0, limit) : items;
---

<section class="section gallery-section" id="gallery" aria-labelledby="gallery-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Campus Life &amp; Activities</span>
      <h2 id="gallery-heading" class="section-title">
        Life at <span class="highlight-yellow">GLOBAL</span>
      </h2>
      <p class="section-subtitle">
        A glimpse into our high-energy speech drills, podium workshops, group discussions, and convocation moments.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid" id="gallery-grid">
      {displayItems.map((item, idx) => (
        <figure class="gallery-item">
          <div class="gallery-image-wrap">
            <img
              src={item.image}
              alt={`Life at GLOBAL photograph ${idx + 1}`}
              width="900"
              height="675"
              loading="lazy"
              class="gallery-image"
            />
          </div>
          {(item.title || item.caption) && (
            <figcaption class="gallery-caption">
              {item.title && <h3 class="gallery-item-title">{item.title}</h3>}
              {item.caption && <p class="gallery-item-desc">{item.caption}</p>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    {showAllLink && (
      <div class="gallery-cta">
        <a href="/gallery" class="btn btn-call">
          View Full Gallery Archive &rarr;
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .gallery-section {
    background-color: #FFFFFF;
  }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: var(--space-10);
  }

  .filter-btn {
    background-color: var(--color-bg-light-grey);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-secondary-blue);
    color: var(--color-secondary-blue);
  }

  .filter-btn--active {
    background-color: var(--color-secondary-blue);
    border-color: var(--color-secondary-blue);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(7, 87, 166, 0.25);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(11, 47, 99, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(11, 47, 99, 0.1);
  }

  .gallery-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-bg-light-blue);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .gallery-item-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: rgba(11, 47, 99, 0.85);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .gallery-caption {
    padding: var(--space-4);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    .gallery-caption {
      padding: var(--space-5);
    }
  }

  .gallery-item-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary-navy);
    margin-bottom: 0.35rem;
  }

  .gallery-item-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .gallery-cta {
    margin-top: var(--space-10);
    text-align: center;
  }
</style>